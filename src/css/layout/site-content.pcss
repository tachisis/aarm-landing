.site-content {
  --site-content-trapezoid-h: 1.6875rem;

  max-width: 82rem;
  margin: 0 auto;
  padding: 0 1rem var(--site-content-trapezoid-h);
  overflow-x: hidden;
}

.site-content-container {
  position: relative;

  --perf-strip: 1rem;
  --perf-dot: 0.375rem;
  --perf-gap: 0.62rem;
  --perf-step: calc(var(--perf-dot) + var(--perf-gap));
  --perf-r: calc(var(--perf-dot) / 2);
  --perf-hole: var(--bg-main);

  padding: 0 1rem;

  background-color: var(--bg-content);
  background-image:
    radial-gradient(
      circle,
      var(--perf-hole) var(--perf-r),
      transparent var(--perf-r)
    ),
    radial-gradient(
      circle,
      var(--perf-hole) var(--perf-r),
      transparent var(--perf-r)
    );
  background-size: var(--perf-strip) var(--perf-step);
  background-position:
    left calc(-1 * var(--perf-step) / 2),
    right calc(-1 * var(--perf-step) / 2);
  background-repeat: repeat-y, repeat-y;

  &::after {
    content: "";
    position: absolute;
    z-index: 1;
    bottom: 0;
    left: 1rem;
    width: calc(100% - 2rem);
    height: var(--site-content-trapezoid-h);
    transform: translateY(100%);
    clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% calc(100% * 13.1538 / 27));
    background: linear-gradient(
      to bottom,
      #ededed 0,
      #fff calc(100% * 10.0385 / 27),
      #fff 100%
    );
  }
}

.site-content-wrapper {
  border: 1px dashed rgba(48, 47, 51, 0.1);
  border-width: 0 1px;
  padding: 1rem 0.5rem;
}

@media (--desktop) {
  .site-content {
    overflow-x: visible;
  }

  .site-content-wrapper {
    --site-content-dash: rgba(48, 47, 51, 0.1);
    --site-content-dash-len: 10px;
    --site-content-dash-gap: 10px;

    padding: 2rem 3rem;

    border-style: solid;
    border-color: transparent;
    background-image:
      repeating-linear-gradient(
        to bottom,
        var(--site-content-dash) 0,
        var(--site-content-dash) var(--site-content-dash-len),
        transparent var(--site-content-dash-len),
        transparent
          calc(var(--site-content-dash-len) + var(--site-content-dash-gap))
      ),
      repeating-linear-gradient(
        to bottom,
        var(--site-content-dash) 0,
        var(--site-content-dash) var(--site-content-dash-len),
        transparent var(--site-content-dash-len),
        transparent
          calc(var(--site-content-dash-len) + var(--site-content-dash-gap))
      );
    background-position: left, right;
    background-size:
      1px 100%,
      1px 100%;
    background-repeat: no-repeat, no-repeat;
  }

  .site-content-container {
    --perf-strip: 2rem;
    --perf-dot: 0.75rem;
    --perf-gap: 1.24rem;

    padding: 0 2rem;

    &::after {
      left: 2rem;
      width: calc(100% - 4rem);
    }
  }
}
