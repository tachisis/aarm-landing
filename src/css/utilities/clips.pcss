.clip-1 {
  content: "";
  display: block;

  position: absolute;

  background: url(../images/clip-1.svg) no-repeat left top;
  background-size: 100% 100%;
}

.clip-2 {
  position: absolute;
  content: "";

  display: block;

  background: url("../images/clip-2.svg") no-repeat;
  background-size: contain;
}

.folder-clip {
  content: "";
  position: absolute;

  background: url("../images/folder-clip.svg") no-repeat center center;
  background-size: contain;
}
