.non-jobs {
  .site-content {
    padding-bottom: 0;
  }

  .site-content-container {
    &::before {
      content: "";
      position: absolute;
      z-index: 9;
      left: 0;
      right: 1rem;
      bottom: calc(1px + 3.25rem);
      height: calc(3.25rem + 1px);
      pointer-events: none;
      transform: translateY(100%);

      background: var(--bg-main);
    }

    &::after {
      @extend .torn-paper;
      aspect-ratio: 20 / 3;
      left: 1rem;
      bottom: calc(1px + 3.25rem);
      right: 0;
      height: calc(3.25rem + 1px);
      transform: translateY(100%);

      background: var(--bg-content);
    }
  }

  .site-content-wrapper {
    padding-top: 2rem;
    padding-bottom: 3.25rem;

    & p {
      font-family: var(--base-font-mono);
      font-size: 0.875rem;
      font-weight: 400;
      line-height: normal;
      margin: 0 0 1rem;

      &:last-child {
        margin: 0;
      }
    }

    a:not([class]) {
      color: var(--text-accent);
    }
  }
}

.non-jobs-hero-title {
  margin: 0 0 1.2rem 1.2rem;

  width: 16.4rem;
  height: 3.2rem;

  background-image: url("../images/non-jobs-title.png");
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.non-jobs-hero-illustration {
  mix-blend-mode: multiply;
}

.non-jobs-intro {
  margin: 0 0 1.6rem;
}

.non-jobs-title {
  margin: 0 0 1rem;

  font-family: var(--base-font-mono);
  font-size: 1rem;
  font-weight: 500;
  line-height: normal;
  text-transform: uppercase;
}

.non-jobs-features {
  position: relative;
  margin: 0 -2.5rem 2rem -1.6rem;
  padding: 2.5rem 0 2.75rem;
  filter: drop-shadow(var(--small-shadow));

  &::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;

    background: linear-gradient(to right, #ae9e8e, #908070);
    clip-path: polygon(
      100% 0,
      2.75rem 0,
      2.533rem 0.019rem,
      2.323rem 0.075rem,
      2.125rem 0.168rem,
      1.947rem 0.293rem,
      1.793rem 0.447rem,
      1.668rem 0.625rem,
      1.575rem 0.823rem,
      1.519rem 1.033rem,
      1.5rem 1.25rem,
      1.5rem 5rem,
      1.35rem 5.45rem,
      1.05rem 5.9rem,
      0.73rem 6.26rem,
      0.35rem 6.6rem,
      0.09rem 7.1rem,
      0 7.5rem,
      0 calc(100% - 1.25rem),
      0.167rem calc(100% - 0.625rem),
      0.625rem calc(100% - 0.167rem),
      1.25rem 100%,
      100% 100%
    );
  }

  & .non-jobs-note:first-of-type {
    margin: 0 0 2.2rem 2.56rem;
  }

  & .non-jobs-note:last-of-type {
    margin: 0 2.25rem 0 -1rem;
    padding: 1.9rem 2.25rem 5.7rem 3.56rem;

    &::before {
      left: auto;
      right: 0.75rem;
    }
  }
}

.non-jobs-features-title {
  position: absolute;
  top: 11rem;
  left: -2.6rem;

  z-index: 20;

  transform: rotate(89.135deg);

  font-size: 0.58144rem;
}

.non-jobs-note {
  position: relative;
  z-index: 10;

  padding: 1.9rem 2.5rem 5.7rem 2.25rem;

  background-color: var(--bg-quinary);
  box-shadow: var(--small-shadow);

  &::before {
    content: "";
    position: absolute;
    left: 0.75rem;
    top: 50%;

    transform: translateY(-50%);

    width: 0.9rem;
    height: 19.2rem;

    background:
      radial-gradient(
        circle 0.45rem at 0.45rem 0.45rem,
        #ac9c8c 99%,
        transparent 100%
      ),
      radial-gradient(
        circle 0.45rem at 0.45rem calc(100% - 0.45rem),
        #ac9c8c 99%,
        transparent 100%
      );
    background-repeat: no-repeat;
  }
}

.non-jobs-list {
  display: flex;
  flex-direction: column;
  gap: 2rem;

  margin-bottom: 2.8rem;
}

@media (--desktop) {
  .non-jobs {
    .site-content-container {
      padding-bottom: 8rem;

      &::before {
        left: 0;
        right: 0;
        width: calc(100% - 2rem);
        height: calc(10rem + 1px);

        bottom: calc(1px + 10rem);
      }

      &::after {
        left: 0;
        right: 0;
        width: calc(100% - 2rem);
        height: calc(10rem + 1px);

        bottom: calc(1px + 10rem);
      }
    }
  }

  .non-jobs-hero {
    position: relative;
    padding: 3.5rem 55% 5.9rem 0;
  }

  .non-jobs-hero-title {
    width: 32.9rem;
    height: 6.5rem;

    margin: 0 0 3.6rem 0.3rem;
  }

  .non-jobs-hero-illustration {
    position: absolute;
    right: 1.6rem;
    top: -2rem;

    width: 26rem;
    height: 24rem;
    aspect-ratio: 13/12;
  }

  .non-jobs-list {
    padding-bottom: 3.8rem;
  }

  .non-jobs-features {
    padding-top: 0;
    margin: 0 -6.25rem 4rem -7rem;

    display: flex;
    gap: 3rem;
    align-items: flex-start;

    & .non-jobs-note:first-of-type {
      margin: -3.7rem 0 0 6rem;
      padding: 2.4rem 3.1rem 3rem 4.5rem;

      max-width: 34.4375rem;
      transform: rotate(2.727deg);

      &::before {
        left: 1.4rem;
      }
    }

    & .non-jobs-note:last-of-type {
      margin: -13.4rem 0 0;
      padding: 2.4rem 3.1rem 3rem 4.5rem;

      max-width: 34.4375rem;
      transform: rotate(-1.392deg);

      &::before {
        right: auto;
        top: 70%;
        left: 1.4rem;
      }
    }

    &::before {
      right: 50%;

      clip-path: polygon(
        100% 0,
        2.75rem 0,
        2.533rem 0.019rem,
        2.323rem 0.075rem,
        2.125rem 0.168rem,
        1.947rem 0.293rem,
        1.793rem 0.447rem,
        1.668rem 0.625rem,
        1.575rem 0.823rem,
        1.519rem 1.033rem,
        1.5rem 1.25rem,
        1.5rem 8.75rem,
        1.35rem 9.2rem,
        1.05rem 9.65rem,
        0.73rem 10.01rem,
        0.35rem 10.35rem,
        0.09rem 10.85rem,
        0 11.25rem,
        0 calc(100% - 1.25rem),
        0.167rem calc(100% - 0.625rem),
        0.625rem calc(100% - 0.167rem),
        1.25rem 100%,
        100% 100%
      );
    }

    &::after {
      content: "";
      position: absolute;
      top: 0;
      left: 50%;
      bottom: 0;
      right: 0;

      background: linear-gradient(to left, #ae9e8e, #908070);
      clip-path: polygon(
        0 0,
        calc(100% - 1.25rem) 0,
        calc(100% - 0.625rem) 0.167rem,
        calc(100% - 0.167rem) 0.625rem,
        100% 1.25rem,
        100% calc(24% - 1.25rem),
        calc(100% - 0.09rem) calc(24% - 0.85rem),
        calc(100% - 0.35rem) calc(24% - 0.35rem),
        calc(100% - 0.73rem) calc(24% + 0.01rem),
        calc(100% - 1.05rem) calc(24% + 0.35rem),
        calc(100% - 1.35rem) calc(24% + 0.85rem),
        calc(100% - 1.5rem) calc(24% + 1.25rem),
        calc(100% - 1.5rem) calc(100% - 1.25rem),
        calc(100% - 1.519rem) calc(100% - 1.033rem),
        calc(100% - 1.575rem) calc(100% - 0.823rem),
        calc(100% - 1.668rem) calc(100% - 0.625rem),
        calc(100% - 1.793rem) calc(100% - 0.447rem),
        calc(100% - 1.947rem) calc(100% - 0.293rem),
        calc(100% - 2.125rem) calc(100% - 0.168rem),
        calc(100% - 2.323rem) calc(100% - 0.075rem),
        calc(100% - 2.533rem) calc(100% - 0.019rem),
        calc(100% - 2.75rem) 100%,
        0 100%
      );
    }
  }

  .non-jobs-features-title {
    left: auto;
    top: 4rem;
    right: -2.2rem;
  }

  .non-jobs-note {
    & .non-jobs-title {
      padding-right: 30%;
      font-family: var(--base-font-mono);
      font-size: 1.5rem;
      font-weight: 400;
      text-transform: none;
    }
  }

  .non-jobs-list {
    margin: 0 -3rem;
    padding: 3.25rem 3rem 5.8rem;

    display: flex;
    flex-direction: row;

    background-image: repeating-linear-gradient(
      to right,
      rgba(48, 47, 51, 0.1) 0,
      rgba(48, 47, 51, 0.1) 10px,
      transparent 10px,
      transparent 20px
    );
    background-position: top;
    background-size: 100% 1px;
    background-repeat: no-repeat;
  }

  .non-jobs-list-item {
    flex: 0 0 50%;
    padding-right: 3.25rem;

    .non-jobs-title {
      margin: 0 0 1.2rem;

      font-family: var(--base-font-mono);
      font-size: 1.5rem;
      font-weight: 400;
      line-height: normal;
      text-transform: none;
    }
  }
}
