.embossing-tape-title {
  display: inline-flex;
  padding: 0.4rem 3rem 0.4rem 0.9rem;

  border-radius: 0.0625rem;
  background: linear-gradient(90deg, #050407 0%, #373639 48.08%, #19181b 100%);

  color: var(--text-invert);

  font-family: "Embossing Tape 1 (BRK)";
  font-weight: 500;
  font-size: var(--text-base);
  text-transform: uppercase;
  text-decoration: none;
}

@media (--desktop) {
  .embossing-tape-title {
    padding: 0.55rem 3.1rem 0.55rem 0.7rem;

    font-size: var(--text-sm);
  }
}
