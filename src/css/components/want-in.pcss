.want-in {
  position: relative;
  margin-top: -0.5rem;
  padding-bottom: 1.3rem;
}

.want-in-illustration {
  margin-bottom: 4.2rem;
}

.want-in-title {
  transform: rotate(-4.295deg) translateX(-1.3rem);
}

.want-in-text {
  p {
    margin-top: 1.8rem;

    font-size: var(--text-base);
    text-transform: uppercase;
    line-height: normal;
  }

  p + p {
    margin-top: 1.5rem;
  }

  p:nth-child(2),
  p:nth-child(3) {
    margin-left: 3.1rem;
  }
}
