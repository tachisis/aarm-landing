@media (--desktop) {
  .main-page {
    background-image:
      url("../images/main-bg-1.png"), url("../images/main-bg-1.png");
    background-repeat: no-repeat, no-repeat;
    background-size:
      18.90625rem 10.625rem,
      18.90625rem 10.625rem;
    background-position:
      calc(50% - 42rem) 15rem,
      calc(50% + 42rem) 35rem;
  }
}
