.jobs {
  & .site-content-container {
    margin-bottom: 5.5rem;

    &::after {
      display: none;
    }
  }

  & .site-content-wrapper {
    padding-top: 2.75rem;
    padding-bottom: 0;

    & p {
      font-family: var(--base-font-mono);
      font-size: 0.875rem;
      font-weight: 400;
      line-height: normal;
      margin: 0 0 1rem;

      &:last-child {
        margin: 0;
      }
    }

    a:not([class]) {
      color: var(--text-accent);
    }
  }
}

.jobs-hero-title {
  margin: 0 0 1.7rem 0.9rem;

  width: 13rem;
  height: 4.8rem;

  background-image: url("../images/jobs-title.png");
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.jobs-hero-illustration {
  margin: 0 0 0 2.5rem;
  mix-blend-mode: multiply;
}

.jobs-intro {
  margin: 0 0 1.1rem;
}

.jobs-title {
  margin: 0 0 1rem;

  font-family: var(--base-font-mono);
  font-size: 1rem;
  font-weight: 500;
  line-height: normal;
  text-transform: uppercase;
}

.jobs-list-items {
  margin: 0;
  padding: 0;
  list-style: none;
}

.jobs-list-item {
  margin: 0 0 2rem;

  &:last-child {
    margin: 0;
  }

  & dl {
    font-family: var(--base-font-mono);
  }

  & dt {
    margin: 0 0 1.2rem;
    font-size: 1rem;
    font-weight: 500;
    line-height: normal;
    text-transform: uppercase;
  }

  & dt .jobs-list-item-title,
  & dd .jobs-list-item-title {
    display: block;
    margin: 0 0 0.4rem;

    font-size: 0.75rem;
    font-weight: 400;
    line-height: normal;
    text-transform: none;
  }

  ol {
    padding-inline-start: 1.2rem;
    margin: 0 0 1rem 0.4rem;

    font-size: 0.875rem;
  }

  ul {
    padding-inline-start: 1.2rem;
    list-style: disc;
    margin-bottom: 1rem;

    font-size: 0.875rem;
  }
}

.jobs-list-item-note {
  position: relative;
  padding: 1.25rem;
  margin-top: 3rem;

  background-color: var(--bg-senary);

  font-family: var(--base-font-sans);
  font-size: 0.875rem;
  font-weight: 400;
  line-height: normal;

  & p {
    font-family: var(--base-font-sans) !important;
  }
}

.jobs-list-item--01 {
  margin: 0 0 1.1rem -2.5rem;
  padding: 1.8rem 1rem 2.4rem 2.5rem;

  background-color: var(--bg-quinary);
  box-shadow: var(--small-shadow);
}

.jobs-list-item--02 {
  margin-bottom: 2.9rem;

  & .jobs-list-item-note {
    transform: rotate(0.723deg);

    &::before {
      content: "";
      position: absolute;
      right: 0.4rem;
      top: -1.7rem;

      width: 11.6rem;
      height: 2.5rem;
      transform: rotate(1.826deg);

      background-color: var(--bg-nonary);
      opacity: 0.3;
    }

    &::after {
      content: "";
      position: absolute;
      left: -0.85rem;
      bottom: -1.3rem;

      width: 11.6rem;
      height: 2.5rem;
      transform: rotate(1.826deg);

      background-color: var(--bg-nonary);
      opacity: 0.3;
    }
  }
}

.jobs-list-item--03 {
  margin: 0 0 2.25rem -2.5rem;
  padding: 1.8rem 1rem 2.4rem 2.5rem;

  background-color: var(--bg-quinary);
  box-shadow: var(--small-shadow);

  & .jobs-list-item-note {
    position: relative;
    min-width: 21rem;
    background-color: var(--bg-content);
    transform: rotate(-3.079deg);

    &::before {
      content: "";
      display: block;

      width: 5.8rem;
      height: 5.5rem;

      transform: rotate(-9.6deg);

      position: absolute;
      top: -1.4rem;
      right: -3.6rem;

      background: url(../images/clip-1.svg) no-repeat left top;
      background-size: 100% 100%;
    }
  }
}

.jobs-list-item--04 {
  & .jobs-list-item-note {
    margin-top: -3.25rem;
    position: relative;
    bottom: -5.5rem;

    transform: rotate(3.039deg);
    padding: 3.125rem 1.25rem 1.25rem 1.25rem;

    background: linear-gradient(180deg, #ffeaa4 19.41%, #ffeeb4 22.17%);
  }
}

@media (--desktop) {
  .jobs {
    & .site-content {
      padding-bottom: 0;
    }

    & .site-content-wrapper {
      padding-top: 4.1rem;
    }

    & .site-content-container {
      margin-bottom: 0;
    }
  }

  .jobs-title {
    margin: 0 0 2.8rem;

    font-family: var(--base-font-sans);
    font-size: 1.5rem;
    font-weight: 400;

    text-transform: none;
  }

  .jobs-hero {
    position: relative;
    padding: 0 28% 2.8rem 0;
  }

  .jobs-intro-text {
    display: flex;
  }

  .jobs-intro-text-column {
    flex: 0 0 50%;
    padding-right: 6rem;
  }

  .jobs-hero-title {
    width: 15.5rem;
    height: 6.8rem;

    margin: 0 0 2.7rem 0;
  }

  .jobs-hero-illustration {
    position: absolute;
    right: 0;
    top: -3.6rem;

    width: 22.75rem;
    height: 23rem;
    aspect-ratio: 73/74;
  }

  .jobs-list-item {
    & dt {
      font-family: var(--base-font-sans);
      font-size: 1.5rem;
      font-weight: 400;

      text-transform: none;
    }
  }

  .jobs-list-item-floating {
    position: relative;

    padding-right: 30%;
  }

  .jobs-list-item--01 {
    margin: 0 0 2.7rem -5.5rem;
    padding: 2.3rem 3rem 4rem 5.5rem;

    & dd {
      column-count: 2;
      column-gap: 3.3rem;
    }
  }

  .jobs-list-item--02 {
    margin: 0 -3rem;
    padding: 2rem 3rem 7.7rem;

    background-image:
      repeating-linear-gradient(
        to right,
        rgba(9, 9, 10, 0.1) 0,
        rgba(48, 47, 51, 0.1) 10px,
        transparent 10px,
        transparent 20px
      ),
      repeating-linear-gradient(
        to right,
        rgba(9, 9, 10, 0.1) 0,
        rgba(48, 47, 51, 0.1) 10px,
        transparent 10px,
        transparent 20px
      );
    background-position: top, bottom;
    background-size: 100% 1px;
    background-repeat: no-repeat;

    & dd {
      padding-right: 20%;
    }

    & .jobs-list-item-floating {
      padding-right: 40%;
    }

    & .jobs-list-item-note {
      position: absolute;

      max-width: 30rem;
      top: 2rem;
      right: -20%;
      margin-top: 0;

      & ul {
        font-size: 0.875rem;
      }
    }
  }

  .jobs-list-item--03 {
    margin: -2.8rem -6rem 2.4rem 6.8rem;

    & dd {
      padding-right: 20%;
    }

    & .jobs-list-item-floating {
      padding-right: 40%;
    }

    & .jobs-list-item-note {
      position: absolute;

      max-width: 30rem;
      top: 2rem;
      right: -30%;
      margin-top: 0;

      & ul {
        font-size: 0.875rem;
      }
    }
  }

  .jobs-list-item--04 {
    margin: 0 -3rem !important;
    padding: 2rem 3rem 3.4rem;

    background-image: repeating-linear-gradient(
      to right,
      rgba(9, 9, 10, 0.1) 0,
      rgba(48, 47, 51, 0.1) 10px,
      transparent 10px,
      transparent 20px
    );
    background-position: top;
    background-size: 100% 1px;
    background-repeat: no-repeat;

    & dd {
      padding-right: 20%;
    }

    & .jobs-list-item-floating {
      padding-right: 40%;
    }

    & .jobs-list-item-note {
      position: absolute;

      max-width: 19rem;
      top: 2rem;
      right: -5%;
      margin-top: 0;

      & ul {
        font-size: 0.875rem;
      }
    }
  }
}
