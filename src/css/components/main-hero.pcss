.main-hero {
  position: relative;

  padding: 0.85rem 0 calc(61 / 60 * 100%);
}

.main-hero-title {
  width: 18.4rem;
  height: 7.1rem;
  margin: 0 0 2.5rem 0.5rem;

  background-image: url("../images/main-title.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.main-hero-text {
  margin-bottom: 2.3rem;

  & p {
    font-size: var(--text-base);
    line-height: 102%;
    text-transform: uppercase;

    &:nth-child(1) {
      margin: 0 0 1.33rem 3.2rem;
    }

    &:nth-child(2) {
      margin: 0 0 1.1rem;
    }

    &:nth-child(3) {
      margin-left: 3.3rem;
    }
  }
}

