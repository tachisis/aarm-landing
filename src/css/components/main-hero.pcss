.main-hero {
  padding: 0.85rem 0 0;
}

.main-hero-title {
  width: 18.4rem;
  height: 7.1rem;
  margin: 0 0 2.5rem 0.5rem;

  background-image: url("../images/header-title.svg");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.main-hero-text p {
  font-size: var(--text-base);
  line-height: 102%;
  text-transform: uppercase;
}

.main-hero-text p:nth-child(1) {
  margin: 0 0 1.33rem 3.2rem;
}

.main-hero-text p:nth-child(2) {
  margin: 0 0 1.1rem;
}

.main-hero-text p:nth-child(3) {
  margin-left: 3.3rem;
}

.main-hero-text-correction {
  position: relative;

  display: block;
  margin: 1.1rem 0 0 8.42rem;
}

.main-hero-text-correction del {
  text-decoration: none;
}

.main-hero-text-correction-stroke {
  position: absolute;
  width: 109px;
  height: 9px;
  left: -0.55rem;
  top: 0.1rem;
  color: var(--text-accent);
}

.main-hero-text-correction ins {
  position: absolute;
  top: -1.3rem;
  left: 0.4rem;
  font-family: "Aaic", sans-serif;
  font-size: var(--text-xl);
  line-height: 1;
  letter-spacing: -0.04em;
  text-decoration: none;
  color: var(--text-accent);
  text-transform: none;
}
