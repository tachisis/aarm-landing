}

.work-ethic-quote p:last-child {
  margin-bottom: 0;
}

.work-ethic-figure {
  margin: 1.75rem auto 0;
  max-width: 16rem;
}

.work-ethic-figure svg {
  display: block;
  width: 100%;
  height: auto;
}


