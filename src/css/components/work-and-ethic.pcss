.work-ethic {
  & .site-content-container {
    &::after {
      display: none;
    }
  }

  & .site-content-wrapper {
    padding-bottom: 0;
  }
}

.work-ethic-hero-title {
  width: 17.9555rem;
  height: 5.2315rem;
  margin: 0.6rem 0 1rem 0.3rem;

  background-image: url("../images/w-e-title.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.work-ethic-intro-box {
  position: relative;
  min-width: 20rem;
  margin: 0 -1rem 1.5rem 0.5rem;
  padding: 1.3rem 1rem 1.2rem 1.4rem;

  background: var(--bg-senary);

  box-shadow: 0 1px 4px 0 rgba(0, 0, 0, 0.15);

  & p {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-style: italic;
    font-size: 0.77238rem;
    line-height: normal;
  }

  & p:nth-child(2) {
    margin-left: 3.05rem;
    margin-bottom: 1.3rem;
  }

  & p + p {
    margin: 1.05rem 0 0;
  }

  &::before {
    content: "";
    display: block;
    width: 2.927rem;
    height: 2.79rem;
    transform: rotate(5.864deg);
    position: absolute;
    bottom: 1.3rem;
    right: -2.3rem;
    background: url(../images/clip-1.svg) no-repeat left top;
    background-size: 100% 100%;
  }
}

.work-ethic-heading {
  margin: 0 0 1rem;

  font-family: "IBM Plex Mono", ui-monospace, monospace;
  font-size: 1rem;
  font-weight: 500;
  line-height: normal;
  text-transform: uppercase;
}

.work-ethic-text {
  & p {
    margin: 0 0 1rem;

    font-size: 0.875rem;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
  }
}

.work-ethic-handwritten {
  font-family: "Aaic", sans-serif;
  font-style: italic;
  color: var(--text-accent);
}

.work-ethic-section--cappuccino {
  & .work-ethic-heading {
    padding-right: 50%;
  }

  & .work-ethic-text {
    & p:first-child {
      margin-bottom: 1.4rem;
    }

    & p {
      font-family: "IBM Plex Mono", ui-monospace, monospace;
    }

    & .work-ethic-text-quote {
      padding-left: 3.4rem;
      font-style: italic;
    }
  }
}

.work-ethic-section--domainless {
  margin-bottom: 2.2rem;

  & .work-ethic-illustration {
    position: relative;

    left: 1.1rem;

    min-width: 23.6rem;
    padding: 1.61rem 6.3rem 29.1rem 3rem;
    background: var(--bg-octonary);

    box-shadow: 0 0.423px 1.693px 0 rgba(0, 0, 0, 0.15);

    & img {
      width: 100%;
      max-width: 326.5px;
      height: auto;
      aspect-ratio: 653 / 802;
      mix-blend-mode: multiply;
    }
  }

  & .work-ethic-heading {
    padding-right: 30%;
    margin-bottom: 2.2rem;
  }

  & .work-ethic-text {
    position: relative;

    min-width: 23.6rem;
    margin: -27rem 0 0 -2.8rem;
    padding: 1.5rem 1.5rem 0.8rem 2.8rem;

    background: var(--bg-quinary);
    box-shadow: 0 0.423px 1.693px 0 rgba(0, 0, 0, 0.15);

    & p {
      padding: 0 0 0 3.4rem;
      line-height: 1.2;
    }

    &::before {
      content: "";
      position: absolute;
      left: 1rem;
      top: 4.8rem;
      width: 1.92352rem;
      height: 19.14095rem;
      background: url("../images/folder-clip.svg") no-repeat center center;
      background-size: contain;
    }
  }
}

.work-ethic-section--engineers {
  margin-bottom: 1.5rem;

  & .work-ethic-heading {
    padding-right: 50%;
    margin-bottom: 1rem;
  }

  & .work-ethic-text {
    & p {
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      line-height: 1.3;
    }
  }
}

.work-ethic-section-join {
  position: relative;
  z-index: 20;

  padding: 0.75rem 0.75rem 2.55rem;
  background: var(--bg-senary);

  box-shadow: 0 1px 4px 0 rgba(0, 0, 0, 0.15);

  &::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2rem;
    height: 2rem;
    background: inherit;
  }
}

