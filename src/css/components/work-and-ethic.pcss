.work-ethic-section--cathedrals {
  & .work-ethic-illustration {
    margin-bottom: 0.5rem;
    mix-blend-mode: multiply;
  }

  & .work-ethic-text {
    & p {
      font-family: "IBM Plex Mono", ui-monospace, monospace;
    }
  }
}

@media (--desktop) {
  .work-ethic-hero {
    margin: 0 -3rem 3rem;
    padding: 3.7rem 3rem 1.1rem;
    background-image: repeating-linear-gradient(
      to right,
      rgba(48, 47, 51, 0.1) 0,
      rgba(48, 47, 51, 0.1) 10px,
      transparent 10px,
      transparent 20px
    );
    background-position: bottom;
    background-size: 100% 1px;
    background-repeat: no-repeat;
  }

  .work-ethic-hero-title {
    width: 34.8815rem;
    height: 10.17288rem;

    margin: 0 0 3.6rem 0;
  }

  .work-ethic-intro-box {
    position: absolute;
    top: 3rem;
    right: 1rem;
    width: 34.5rem;
    margin: 0;
    padding: 2.7rem 2.8rem 3.1rem;

    & p {
      font-size: 1.25rem;
    }

    & p + p {
      margin-top: 1.6rem;
    }

    & p:nth-child(2) {
      margin-left: 4.9rem;
      margin-bottom: 2.1rem;
    }

    &::before {
      bottom: 1.6rem;
      right: -4.5rem;
      width: 5.83563rem;
      height: 5.5625rem;
      transform: rotate(5.864deg);
    }
  }

  .work-ethic-heading {
    font-size: 1.5rem;

    margin-bottom: 2.4rem;
  }

  .work-ethic-text {
    & p {
      font-size: 1.25rem;
    }
  }

  .work-ethic-section--cappuccino {
    & .work-ethic-heading {
      padding-right: 80%;
    }

    & .work-ethic-text {
      column-count: 2;
      column-gap: 0;

      & p {
        padding-right: 4rem;
      }

      & p + p {
        margin-top: 3.2rem;
      }

      & .work-ethic-text-quote {
        padding-left: 0;
      }

      & p:nth-child(2) {
        margin-top: 2.6rem;
        padding-left: 5rem !important;
      }
    }
  }

  .work-ethic-section--domainless {
    position: relative;
    margin: 0 -3rem 2.5rem;
    padding: 0 3rem 3.9rem;
    background-image: repeating-linear-gradient(
      to right,
      rgba(48, 47, 51, 0.1) 0,
      rgba(48, 47, 51, 0.1) 10px,
      transparent 10px,
      transparent 20px
    );
    background-position: bottom;
    background-size: 100% 1px;
    background-repeat: no-repeat;

    & .work-ethic-illustration {
      position: absolute;

      top: 2rem;
      left: -5.5rem;
      right: 3rem;

      padding: 2rem 0 2rem 72%;

      & img {
        width: 18.0625rem;
        height: 24.875rem;
        aspect-ratio: 61/84;
      }
    }

    & .work-ethic-heading {
      padding-right: 0;
      margin-bottom: 2.3rem;
    }

    & .work-ethic-text {
      max-width: 68%;
      margin: 0;
      left: -7.8rem;

      padding: 5.9rem 5rem 4rem 7.7rem;

      & p {
        padding-left: 5.3rem;
        margin-bottom: 1.6rem;
        font-size: 0.875rem;
      }

      &::before {
        top: 0;
        left: 2.9rem;
        width: 2.94688rem;
        height: 29.325rem;
      }
    }
  }

  .work-ethic-section--engineers {
    margin-bottom: 3.8rem;

    & .work-ethic-heading {
      margin-bottom: 2.3rem;
    }

    & .work-ethic-text {
      display: flex;

      & p {
        flex: 0 0 50%;
        padding-right: 6rem;
        margin-bottom: 0;

        font-size: 0.875rem;
      }
    }
  }

  .work-ethic-section-join {
    margin: 0 0 0 -1.8rem;
    padding: 1.7rem 1.9rem 2rem;
  }

  .work-ethic-section--frontier {
    margin-right: -10rem;
    padding: 4.5rem 5.6rem 4.7rem;

    & .work-ethic-heading {
      max-width: 47%;

      margin-bottom: 1.8rem;
    }

    & .work-ethic-text {
      position: relative;
      display: flex;

      & p {
        flex: 0 0 50%;
        padding-right: 6rem;
        margin-bottom: 0;

        font-size: 0.875rem;
      }
    }

    & .work-ethic-handwritten {
      position: absolute;
      bottom: -3rem;
      right: -6rem;

      z-index: 20;

      max-width: 30rem;

      font-size: 2rem !important;
    }

    &::after {
      aspect-ratio: 78 / 9;
    }
  }

  .work-ethic-section--cathedrals {
    position: relative;
    padding: 0.9rem 58% 0 0;

    & .work-ethic-illustration {
      position: absolute;
      top: 1rem;
      right: 1.7rem;
      margin: 0;

      width: 33.0625rem;
      height: 19.9375rem;
      aspect-ratio: 131/79;
      transform: scaleX(-1);
    }

    & .work-ethic-heading {
      max-width: 22rem;

      margin-bottom: 1.8rem;
    }

    & .work-ethic-text {
      & p {
        font-size: 0.875rem;
      }
    }
  }
}
