.specialisms {
  position: relative;
  margin: -0.8rem 0 0;

  background: url("../images/specialisms-bg.svg") no-repeat left top;
}

.specialisms-title {
  margin: 2.1rem 0 3.5rem -0.62rem;

  transform: rotate(-2.736deg);
}

.specialisms-heading {
  text-transform: uppercase;
  font-size: var(--text-xl);
  font-weight: 500;
  line-height: normal;
}

.specialisms-01 {
  &.folder {
    padding-bottom: 13.81rem;
  }

  & .specialisms-illustration {
    width: 100%;
    min-width: 20.40944rem;
    min-height: 12.3125rem;
    aspect-ratio: 121/73;

    margin: 0 0 1.1rem -2.1rem;
  }

  & .specialisms-heading {
    max-width: 14.25rem;
    padding: 0 1rem;
    margin: 0 0 0.6rem;
  }

  & .specialisms-text {
    padding: 0 1rem;

    & span {
      display: block;
      font-size: var(--text-sm);
      line-height: normal;
    }

    & span:nth-child(1) {
      max-width: 85%;
      margin-bottom: 0.88rem;
    }

    & span:nth-child(2) {
      opacity: 0.5;
      padding: 0 0.5rem 0 1.2rem;
      margin-bottom: 0.74rem;
    }

    & span:nth-child(3) {
      padding: 0 2.2rem;
      margin-bottom: 0.92rem;
    }

    & span:nth-child(4) {
      padding: 0 0.68rem 0 2.2rem;
    }
  }
}

.specialisms-02 {
  &.folder {
    padding-top: 1.1rem;
  }

  margin: -10.5rem 0 0 -0.5rem;

  &.folder {
    padding-bottom: 13.81rem;
  }

  & .specialisms-illustration {
    position: relative;
    right: -1.2rem;
    width: 100%;
    min-width: 20.40944rem;
    min-height: 12.3125rem;
    aspect-ratio: 121/73;

    margin: 0 0 1.7rem 0;
  }

  & .specialisms-heading {
    margin-bottom: 0.75rem;
  }

  & .specialisms-text {
    position: relative;
    margin-left: 1.4rem;
    margin-right: -1rem;

    padding: 1.1rem 0 1.8rem 1rem;
    border-radius: 0.125rem;
    background: var(--bg-content);
    box-shadow: var(--base-shadow);

    color: var(--text-primary);

    &::before {
      content: "";
      display: block;
      width: 3.89575rem;
      height: 3.71338rem;
      transform: rotate(-13.151deg);
      position: absolute;
      top: -1.1rem;
      right: -2.3rem;
      background: url("../images/clip-1.svg") no-repeat left top;
      background-size: 100% 100%;
    }

    & p {
      max-width: 77%;
      font-weight: 500;
      line-height: normal;
      font-size: var(--text-sm);
    }

    & p + p {
      margin-top: 0.9rem;
    }
  }
}

.specialisms-03 {
  position: relative;
  margin: -9.5rem -1.6rem 0 1rem;

  &.folder {
    padding: 1.61rem 0 0;
  }

  & .specialisms-heading {
    margin-bottom: 1rem;
  }

  & .specialisms-text {
    margin: 0 1.25rem 0 1.1rem;
    padding: 1.38rem 0 7.05rem 1.4rem;
    background: var(--bg-content);

    color: var(--text-primary);

    transform: rotate(-1.135deg);

    & p {
      padding-right: 1rem;
      font-weight: 500;
      line-height: normal;
      font-size: var(--text-sm);
    }

    & p + p {
      margin-top: 0.9rem;
    }
  }

  & .specialisms-illustration {
    position: relative;
    margin: -5.5rem 0 3.44rem;

    border-radius: 1rem;
    padding: 1.25rem 2.25rem 2.25rem;
    background: linear-gradient(180deg, #908070 0%, #726252 100%);

    box-shadow: 0 -10px 34px rgba(0, 0, 0, 0.25);

    & img {
      position: relative;
      z-index: 10;
      width: 100%;

      min-width: 20.40944rem;
      min-height: 12.3125rem;
      aspect-ratio: 121/73;

      margin-left: -5.1rem;
    }

    &::before {
      position: absolute;
      top: -0.5rem;
      right: 1.92rem;
      z-index: 20;
      content: "";
      display: block;
      width: 1.29038rem;
      height: 4.07294rem;
      background: url("../images/clip-2.svg") no-repeat;
      background-size: contain;
    }

    &::after {
      content: "";
      display: block;
      width: 9.625rem;
      height: 11.375rem;
      aspect-ratio: 11/13;
      background: url("../images/mark.png") no-repeat;
      background-size: contain;
      mix-blend-mode: multiply;
      position: absolute;
      bottom: -3.44rem;
      left: -3.5rem;
    }
  }
}

.specialisms-04 {
  margin-top: -1.7rem;
  margin-bottom: 8.24rem;

  &.folder {
    padding-top: 1.69rem;
    padding-bottom: 5.3rem;
    padding-left: 0.9rem;
  }

  & .specialisms-illustration {
    position: absolute;
    bottom: -4.7rem;
    left: 0.5rem;

    width: 100%;
    min-width: 20.40944rem;
    min-height: 12.3125rem;
    aspect-ratio: 121/73;
  }

  & .specialisms-heading {
    margin-bottom: 1.25rem;
  }

  & .specialisms-text {
    position: relative;
    margin-right: -0.5rem;
    padding: 1.5rem 0.5rem 0 2.31rem;

    background: var(--bg-content);
    border-radius: 0.125rem;
    box-shadow: var(--base-shadow);

    color: var(--text-primary);

    & p {
      font-weight: 500;
      line-height: normal;
      font-size: var(--text-sm);
    }

    & p + p {
      margin-top: 0.9rem;
    }

    &::before {
      content: "";
      position: absolute;
      left: 0.5rem;
      top: 10.31rem;
      width: 1rem; /* 16px */
      height: 15.625rem; /* 250px */
      background:
        radial-gradient(
          circle 0.5rem at 0.5rem 0.5rem,
          var(--bg-secondary) 99%,
          transparent 100%
        ),
        radial-gradient(
          circle 0.5rem at 0.5rem calc(100% - 0.5rem),
          var(--bg-secondary) 99%,
          transparent 100%
        );
      background-repeat: no-repeat;
    }

    &::after {
      content: "";
      position: absolute;
      z-index: 10;
      right: 1.19rem;
      top: 15.37rem;
      width: 1rem; /* 16px */
      height: 15.625rem; /* 250px */
      background:
        radial-gradient(
          circle 0.5rem at 0.5rem 0.5rem,
          var(--bg-secondary) 99%,
          transparent 100%
        ),
        radial-gradient(
          circle 0.5rem at 0.5rem calc(100% - 0.5rem),
          var(--bg-secondary) 99%,
          transparent 100%
        );
      background-repeat: no-repeat;
    }
  }

  & .specialisms-text-content {
    padding: 1rem 2.81rem 3.5rem 1rem;

    border-radius: 0.125rem;
    background: var(--bg-senary);
    box-shadow: var(--base-shadow);
  }
}
