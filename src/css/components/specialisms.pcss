.specialisms {
  position: relative;
  margin-top: -5rem;

  background: url("../images/specialisms-bg.svg") no-repeat left top;
}

.specialisms-title {
  margin: 2.1rem 0 3.5rem -0.62rem;

  transform: rotate(-2.736deg);
}

.specialisms-heading {
  text-transform: uppercase;
  font-size: var(--text-xl);
  font-weight: 500;
  line-height: normal;
}

.specialisms-01 {
  &.folder {
    padding-bottom: 13.81rem;
  }

  & .specialisms-illustration {
    width: 100%;
    min-width: 20.40944rem;
    min-height: 12.3125rem;
    aspect-ratio: 121/73;

    margin: 0 0 1.1rem -2.1rem;
  }

  & .specialisms-heading {
    max-width: 14.25rem;
    padding: 0 1rem;
    margin: 0 0 0.6rem;
  }

  & .specialisms-text p {
    padding: 0 1rem;

    & span {
      display: block;
      font-size: var(--text-sm);
      line-height: normal;
    }

    & span:nth-child(1) {
      max-width: 85%;
      margin-bottom: 0.88rem;
    }

    & span:nth-child(2) {
      opacity: 0.5;
      padding: 0 0.5rem 0 1.2rem;
      margin-bottom: 0.74rem;
    }

    & span:nth-child(3) {
      padding: 0 2.2rem;
      margin-bottom: 0.92rem;
    }

    & span:nth-child(4) {
      padding: 0 0.68rem 0 2.2rem;
    }
  }
}

.specialisms-02 {
  &.folder {
    padding-top: 1.1rem;
  }

  margin: -10.2rem 0 0 -0.5rem;

  &.folder {
    padding-bottom: 13.81rem;
  }

  & .specialisms-illustration {
    position: relative;
    right: -1.2rem;
    width: 100%;
    min-width: 20.40944rem;
    min-height: 12.3125rem;
    aspect-ratio: 121/73;

    margin: 0 0 1.7rem 0;
  }

  & .specialisms-heading {
    margin-bottom: 0.75rem;
  }

  & .specialisms-text {
    position: relative;
    margin-left: 1.4rem;
    margin-right: -1rem;

    padding: 1.1rem 0 1.8rem 1rem;
    border-radius: 0.125rem;
    background: var(--bg-content);
    box-shadow: var(--base-shadow);

    color: var(--text-primary);

    &::before {
      @extend .clip-1;
      width: 3.8rem;
      height: 3.7rem;
      transform: rotate(-13.1deg);
      top: -1.1rem;
      right: -2.3rem;
    }

    & p {
      max-width: 77%;
      font-weight: 500;
      line-height: normal;
      font-size: var(--text-sm);
    }

    & p + p {
      margin-top: 0.9rem;
    }
  }
}

.specialisms-03 {
  position: relative;
  margin: -9.8rem -1.6rem 0 1rem;

  &.folder {
    padding: 1.61rem 0 0;
  }

  & .specialisms-heading {
    margin-bottom: 1rem;
  }

  & .specialisms-text {
    margin: 0 1.25rem 0 1.1rem;
    padding: 1.38rem 0 7.05rem 1.4rem;
    background: var(--bg-content);

    color: var(--text-primary);

    transform: rotate(-1.135deg);

    & p {
      padding-right: 1rem;
      font-weight: 500;
      line-height: normal;
      font-size: var(--text-sm);
    }

    & p + p {
      margin-top: 0.9rem;
    }
  }

  & .specialisms-illustration {
    position: relative;
    margin: -5.5rem 0 3.44rem;

    border-radius: 1rem;
    padding: 1.25rem 2.25rem 2.25rem;
    background: linear-gradient(180deg, #908070 0%, #726252 100%);

    box-shadow: 0 -10px 34px rgba(0, 0, 0, 0.25);

    & img {
      position: relative;
      z-index: 10;
      width: 100%;

      min-width: 20.40944rem;
      min-height: 12.3125rem;
      aspect-ratio: 121/73;

      margin-left: -5.1rem;
    }

    &::before {
      @extend .clip-2;

      top: -0.5rem;
      right: 2.5rem;
      z-index: 20;

      width: 1.5rem;
      height: 5rem;

      transform: rotate(16deg);
    }

    &::after {
      content: "";
      display: block;
      width: 9.625rem;
      height: 11.375rem;
      aspect-ratio: 11/13;
      background: url("../images/mark.webp") center / contain no-repeat;
      mix-blend-mode: multiply;
      position: absolute;
      bottom: -3.44rem;
      left: -3.5rem;
    }
  }
}

.specialisms-04 {
  margin-top: -1.5rem;
  margin-bottom: 8.24rem;

  &.folder {
    padding-top: 1.69rem;
    padding-bottom: 5.3rem;
    padding-left: 0.9rem;
  }

  & .specialisms-illustration {
    position: absolute;
    bottom: -4.7rem;
    left: 0.5rem;

    width: 100%;
    min-width: 20.40944rem;
    min-height: 12.3125rem;
    aspect-ratio: 121/73;
  }

  & .specialisms-heading {
    margin-bottom: 1.25rem;
  }

  & .specialisms-text {
    position: relative;
    margin-right: -0.5rem;
    padding: 1.5rem 0.5rem 0 2.31rem;

    background: var(--bg-content);
    border-radius: 0.125rem;
    box-shadow: var(--base-shadow);

    color: var(--text-primary);

    & p {
      font-weight: 500;
      line-height: normal;
      font-size: var(--text-sm);
    }

    & p + p {
      margin-top: 0.9rem;
    }

    &::before {
      content: "";
      position: absolute;
      left: 0.5rem;
      top: 10.31rem;
      width: 1rem;
      height: 15.625rem;
      background:
        radial-gradient(
          circle 0.5rem at 0.5rem 0.5rem,
          var(--bg-secondary) 99%,
          transparent 100%
        ),
        radial-gradient(
          circle 0.5rem at 0.5rem calc(100% - 0.5rem),
          var(--bg-secondary) 99%,
          transparent 100%
        );
      background-repeat: no-repeat;
    }

    &::after {
      content: "";
      position: absolute;
      z-index: 10;
      right: 1.19rem;
      top: 15.37rem;
      width: 1rem;
      height: 15.625rem;
      background:
        radial-gradient(
          circle 0.5rem at 0.5rem 0.5rem,
          var(--bg-secondary) 99%,
          transparent 100%
        ),
        radial-gradient(
          circle 0.5rem at 0.5rem calc(100% - 0.5rem),
          var(--bg-secondary) 99%,
          transparent 100%
        );
      background-repeat: no-repeat;
    }
  }

  & .specialisms-text-content {
    padding: 1rem 2.81rem 3.5rem 1rem;

    border-radius: 0.125rem;
    background: var(--bg-senary);
    box-shadow: var(--base-shadow);
  }
}

@media (--desktop) {
  .specialisms {
    margin-top: 0;

    background-size: 20.25rem 27.72rem;
    background-position: 4.04rem top;

    &::before {
      content: "";

      position: absolute;
      top: 8.23rem;
      left: 1.2rem;

      width: 25.76906rem;
      height: 16.4375rem;

      border-radius: 3.125rem 3.125rem 0 0;
      background: linear-gradient(180deg, #d1d3c5 72.96%, #a8a9a2 100%);
    }
  }

  .specialisms-title {
    margin-left: 2.8rem;
  }

  .specialisms-01 {
    margin-top: 2.4rem;

    &.folder {
      padding: 0 5.06rem 12.19rem 10.06rem;
    }

    & .specialisms-illustration {
      position: relative;
      top: -4.5rem;

      margin: 0;
    }

    & .specialisms-heading {
      max-width: none;
      flex: 0 0 40%;
      margin: 0;
      padding: 0;

      font-size: var(--text-lg);
    }

    & .specialisms-text {
      position: relative;
      top: -3rem;
      display: flex;
      gap: 3.6rem;

      & p {
        padding: 1.2rem 0 0;

        & span {
          font-size: var(--text-xs);
          font-weight: 500;
        }

        & span:nth-child(2) {
          padding: 0 0 0 6.4rem;
          margin-bottom: 1rem;
          text-indent: -2rem;
          font-style: italic;
        }

        & span:nth-child(3) {
          padding-left: 0;
          margin-bottom: 1rem;
        }

        & span:nth-child(4) {
          padding-left: 0;
        }
      }
    }
  }

  .specialisms-02 {
    margin: -9rem -1.1rem 0 -6.52rem;

    &.folder {
      padding-top: 0;
      padding-left: 3.5rem;
      padding-bottom: 7.4rem;
    }

    display: flex;

    & .specialisms-illustration {
      flex: 0 0 74%;

      position: relative;
      top: -2rem;
      right: auto;
    }

    & .specialisms-text {
      margin: 3.4rem 0 0;
      padding-right: 1rem;
      padding-bottom: 3.75rem;
      left: -1rem;
      align-self: flex-start;

      & p {
        max-width: none;
        font-size: var(--text-xs);
      }

      &::before {
        width: 5.6rem;
        height: 5.6rem;

        top: 0.8rem;
        right: -4rem;

        transform: rotate(-9.36deg);
      }
    }

    & .specialisms-heading {
      padding: 0 0 0 0;
      font-size: var(--text-lg);
    }
  }

  .specialisms-03 {
    margin: -4.2rem -3rem 2.81rem 0;

    & .folder-tab {
      left: 1.6rem;
    }

    &.folder {
      padding-top: 1.9rem;
      padding-bottom: 16.84rem;
    }

    & .specialisms-text {
      display: flex;
      flex-wrap: wrap;

      margin: 0 8.5rem 0 4.1rem;
      padding: 3.9rem 1rem 17.6rem 2.4rem;

      & p {
        flex: 0 0 50%;
        padding-right: 2rem;

        font-size: var(--text-xs);
      }

      & p + p {
        margin: 0;
      }

      & p:last-child {
        padding-left: 0.4rem;
        padding-right: 6rem;
      }
    }

    & .specialisms-heading {
      flex: 0 0 100%;
      font-size: var(--text-lg);

      margin: 0 0 1.1rem;
    }

    & .specialisms-illustration {
      position: absolute;
      left: -1.25rem;
      bottom: -5.7rem;
      margin: 0;
      padding: 0;
      width: calc(100% + 2.5rem);

      aspect-ratio: 1206 / 562;

      border-radius: 0;
      box-shadow: none;
      background: url("../images/specialisms-03-bg.svg") no-repeat center / 100%
        100%;

      filter: drop-shadow(0 -10px 17px rgba(0, 0, 0, 0.25));

      & img {
        margin: 0;
        position: absolute;
        top: -2.3rem;
        right: 4.25rem;
        z-index: 19;

        max-width: 72.5%;
      }

      &::before {
        top: -0.8rem;
        right: 3.6rem;
        width: 2rem;
        height: 5.98763rem;
        transform: rotate(34.27deg);
      }

      &::after {
        top: 2.1rem;
        left: 20%;
        bottom: auto;
        width: 11.98219rem;
        height: 23.945rem;
        transform: rotate(-2.893deg);
        background: linear-gradient(180deg, #d1d3c5 0%, #bdbfb1 100%);
        mix-blend-mode: normal;
      }
    }

    &::before {
      content: "";
      display: block;
      width: 16rem;
      height: 19rem;
      aspect-ratio: 16/19;
      background: url("../images/mark.webp") center / contain no-repeat;
      mix-blend-mode: multiply;
      position: absolute;
      top: -10.66rem;
      right: 2.12rem;
      z-index: 20;
    }
  }

  .specialisms-04 {
    position: relative;
    margin: 3.3rem 1rem 0 -1rem;

    & .folder-tab--right {
      right: auto !important;
      left: 2.7rem;
      padding: 0.5rem 0 0.95rem 2rem !important;
      text-align: left !important;
      clip-path: path(
        "M16.5 13C16.5 5.8203 22.3203 0 29.5 0H86.6729C91.2213 0 95.4389 2.37716 97.7942 6.26824L113.706 32.5553C116.061 36.4463 120.279 38.8235 124.827 38.8235H148C150.209 38.8235 152 40.6144 152 42.8235V51.5H0V38.8235H3.5C10.6797 38.8235 16.5 33.0032 16.5 25.8235V13Z"
      ) !important;
    }

    &.folder {
      padding-top: 1.4rem;
      padding-left: 3.9rem;
      padding-bottom: 20.62rem;
    }

    & .specialisms-illustration {
      max-width: 54.5rem;
      top: 17.38rem;
      left: 6rem;
      right: auto;
      bottom: auto;
      z-index: 20;
    }

    & .specialisms-heading {
      margin-bottom: 1rem;
      max-width: 40%;
      font-size: var(--text-lg);
    }

    .specialisms-text {
      margin: 0;
      padding: 0.8rem 0 0 2.31rem;

      max-width: 78.5%;

      & p {
        font-size: var(--text-xs);
      }

      &::before {
        left: 1.5rem;
        top: 9.8rem;
        height: 16.8rem;
      }

      &::after {
        right: -7.9rem;
        top: 16rem;
        height: 16.8rem;
      }
    }

    & .specialisms-text-content {
      display: flex;
      margin-right: -8.75rem;
      margin-left: 5rem;
      padding-bottom: 26.81rem;

      & > div {
        flex: 0 0 50%;
        padding-right: 4rem;
      }
    }
  }
}
