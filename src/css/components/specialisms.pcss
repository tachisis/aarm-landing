.specialisms {
  position: relative;
  margin-top: -5rem;

  background: url("../images/specialisms-bg.svg") no-repeat left top;
}

.specialisms-title {
  margin: 2.1rem 0 3.5rem -0.62rem;

  transform: rotate(-2.736deg);
}

.specialisms-heading {
  text-transform: uppercase;
  font-size: var(--text-xl);
  font-weight: 500;
  line-height: normal;
}

.specialisms-01 {
  &.folder {
    padding-bottom: 13.81rem;
  }

  & .specialisms-illustration {
    width: 100%;
    min-width: 20.40944rem;
    min-height: 12.3125rem;
    aspect-ratio: 121/73;

    margin: 0 0 1.1rem -2.1rem;
  }

  & .specialisms-heading {
    max-width: 14.25rem;
    padding: 0 1rem;
    margin: 0 0 0.6rem;
  }

  & .specialisms-text p {
    padding: 0 1rem;

    & span {
      display: block;
      font-size: var(--text-sm);
      line-height: normal;
    }

    & span:nth-child(1) {
      max-width: 85%;
      margin-bottom: 0.88rem;
    }

    & span:nth-child(2) {
      opacity: 0.5;
      padding: 0 0.5rem 0 1.2rem;
      margin-bottom: 0.74rem;
    }

    & span:nth-child(3) {
      padding: 0 2.2rem;
      margin-bottom: 0.92rem;
    }

    & span:nth-child(4) {
      padding: 0 0.68rem 0 2.2rem;
    }
  }
}

.specialisms-02 {
  &.folder {
    padding-top: 1.1rem;
  }

  margin: -10.2rem 0 0 -0.5rem;

  &.folder {
    padding-bottom: 13.81rem;
  }

  & .specialisms-illustration {
    position: relative;
    right: -1.2rem;
    width: 100%;
    min-width: 20.40944rem;
    min-height: 12.3125rem;
    aspect-ratio: 121/73;

    margin: 0 0 1.7rem 0;
  }

  & .specialisms-heading {
    margin-bottom: 0.75rem;
  }

  & .specialisms-text {
    position: relative;
    margin-left: 1.4rem;
    margin-right: -1rem;

    padding: 1.1rem 0 1.8rem 1rem;
    border-radius: 0.125rem;
    background: var(--bg-content);
    box-shadow: var(--base-shadow);

    color: var(--text-primary);

    &::before {
      content: "";
      display: block;
      width: 3.89575rem;
      height: 3.71338rem;
      transform: rotate(-13.151deg);
      position: absolute;
      top: -1.1rem;
      right: -2.3rem;
      background: url("../images/clip-1.svg") no-repeat left top;
      background-size: 100% 100%;
    }

    & p {
      max-width: 77%;
      font-weight: 500;
      line-height: normal;
      font-size: var(--text-sm);
    }

    & p + p {
      margin-top: 0.9rem;
    }
  }
}

.specialisms-03 {
  position: relative;
  margin: -9.8rem -1.6rem 0 1rem;

  &.folder {
    padding: 1.61rem 0 0;
  }

  & .specialisms-heading {
    margin-bottom: 1rem;
  }

  & .specialisms-text {
    margin: 0 1.25rem 0 1.1rem;
    padding: 1.38rem 0 7.05rem 1.4rem;
    background: var(--bg-content);

    color: var(--text-primary);

    transform: rotate(-1.135deg);

    & p {
      padding-right: 1rem;
      font-weight: 500;
      line-height: normal;
      font-size: var(--text-sm);
    }

    & p + p {
      margin-top: 0.9rem;
    }
  }

  & .specialisms-illustration {
    position: relative;
    margin: -5.5rem 0 3.44rem;

    border-radius: 1rem;
    padding: 1.25rem 2.25rem 2.25rem;
    background: linear-gradient(180deg, #908070 0%, #726252 100%);

    box-shadow: 0 -10px 34px rgba(0, 0, 0, 0.25);

    & img {
      position: relative;
      z-index: 10;
      width: 100%;

      min-width: 20.40944rem;
      min-height: 12.3125rem;
      aspect-ratio: 121/73;

      margin-left: -5.1rem;
    }

    &::before {
      position: absolute;
      top: -0.5rem;
      right: 2.5rem;
      z-index: 20;

      content: "";

      display: block;
      width: 1.5rem;
      height: 5rem;

      background: url("../images/clip-2.svg") no-repeat;
      background-size: contain;

      transform: rotate(16deg);
    }

    &::after {
      content: "";
      display: block;
      width: 9.625rem;
      height: 11.375rem;
      aspect-ratio: 11/13;
      background: url("../images/mark.png") no-repeat;
      background-size: contain;
      mix-blend-mode: multiply;
      position: absolute;
      bottom: -3.44rem;
      left: -3.5rem;
    }
  }
}

.specialisms-04 {
  margin-top: -1.5rem;
  margin-bottom: 8.24rem;

  &.folder {
    padding-top: 1.69rem;
    padding-bottom: 5.3rem;
    padding-left: 0.9rem;
  }

  & .specialisms-illustration {
    position: absolute;
    bottom: -4.7rem;
    left: 0.5rem;

    width: 100%;
    min-width: 20.40944rem;
    min-height: 12.3125rem;
    aspect-ratio: 121/73;
  }

  & .specialisms-heading {
    margin-bottom: 1.25rem;
  }

  & .specialisms-text {
    position: relative;
    margin-right: -0.5rem;
    padding: 1.5rem 0.5rem 0 2.31rem;

    background: var(--bg-content);
    border-radius: 0.125rem;
    box-shadow: var(--base-shadow);

    color: var(--text-primary);

    & p {
      font-weight: 500;
      line-height: normal;
      font-size: var(--text-sm);
    }

    & p + p {
      margin-top: 0.9rem;
    }

    &::before {
      content: "";
      position: absolute;
      left: 0.5rem;
      top: 10.31rem;
      width: 1rem; /* 16px */
      height: 15.625rem; /* 250px */
      background:
        radial-gradient(
          circle 0.5rem at 0.5rem 0.5rem,
          var(--bg-secondary) 99%,
          transparent 100%
        ),
        radial-gradient(
          circle 0.5rem at 0.5rem calc(100% - 0.5rem),
          var(--bg-secondary) 99%,
          transparent 100%
        );
      background-repeat: no-repeat;
    }

    &::after {
      content: "";
      position: absolute;
      z-index: 10;
      right: 1.19rem;
      top: 15.37rem;
      width: 1rem; /* 16px */
      height: 15.625rem; /* 250px */
      background:
        radial-gradient(
          circle 0.5rem at 0.5rem 0.5rem,
          var(--bg-secondary) 99%,
          transparent 100%
        ),
        radial-gradient(
          circle 0.5rem at 0.5rem calc(100% - 0.5rem),
          var(--bg-secondary) 99%,
          transparent 100%
        );
      background-repeat: no-repeat;
    }
  }

  & .specialisms-text-content {
    padding: 1rem 2.81rem 3.5rem 1rem;

    border-radius: 0.125rem;
    background: var(--bg-senary);
    box-shadow: var(--base-shadow);
  }
}

@media (--desktop) {
  .specialisms {
    margin-top: 0;

    background-size: 20.25rem 27.72rem;
    background-position: 4.04rem top;

    &::before {
      content: "";

      position: absolute;
      top: 8.23rem;
      left: 1.2rem;

      width: 25.76906rem;
      height: 16.4375rem;

      border-radius: 3.125rem 3.125rem 0 0;
      background: linear-gradient(180deg, #d1d3c5 72.96%, #a8a9a2 100%);
    }
  }

  .specialisms-title {
    margin-left: 2.8rem;
  }

  .specialisms-01 {
    margin-top: 2.5rem;

    &.folder {
      padding: 0 5.06rem 12.19rem 10.06rem;
    }

    & .specialisms-illustration {
      position: relative;
      top: -4.5rem;

      margin: 0;
    }

    & .specialisms-heading {
      max-width: none;
      flex: 0 0 40%;
      margin: 0;
      padding: 0;

      font-size: var(--text-lg);
    }

    & .specialisms-text {
      position: relative;
      top: -3.5rem;
      display: flex;
      gap: 3.6rem;

      & p {
        padding: 1.2rem 0 0;

        & span {
          font-size: var(--text-xs);
          font-weight: 500;
        }

        & span:nth-child(2) {
          padding: 0 0 0 6.4rem;
          margin-bottom: 1rem;
          text-indent: -2rem;
          font-style: italic;
        }

        & span:nth-child(3) {
          padding-left: 0;
          margin-bottom: 1rem;
        }

        & span:nth-child(4) {
          padding-left: 0;
        }
      }
    }
  }

  .specialisms-02 {
    margin: -9.2rem -1.1rem 0 -6.52rem;

    &.folder {
      padding-top: 0;
      padding-left: 3.5rem;
    }

    display: flex;

    & .specialisms-illustration {
      flex: 0 0 74%;

      position: relative;
      top: -2rem;
      right: auto;
    }

    & .specialisms-text {
      margin: 3.4rem 0 0;
      padding-right: 1rem;
      padding-bottom: 3.75rem;
      left: -1rem;
      align-self: flex-start;

      & p {
        max-width: none;
        font-size: var(--text-xs);
      }

      &::before {
        width: 5.6rem;
        height: 5.6rem;

        top: 0.8rem;
        right: -4rem;

        transform: rotate(-9.36deg);
      }
    }

    & .specialisms-heading {
      padding: 0 0 0 0;
      font-size: var(--text-lg);
    }
  }
}
