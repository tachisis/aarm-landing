@media (--desktop) {
  .talk-to-us {
    & .site-content-wrapper {
      padding-top: 3.5rem;
    }
  }

  .talk-to-us-title {
    font-size: 1.5rem;
    font-weight: 400;
    text-transform: none;
  }

  .talk-to-us-hero {
    position: relative;
    padding-bottom: 11.5rem;
  }

  .talk-to-us-hero-title {
    width: 34.4rem;
    height: 7.1rem;

    margin-bottom: 2.9rem;
  }

  .talk-to-us-hero-illustration {
    position: absolute;
    left: -1rem;
    bottom: 0;

    width: 24rem;
    height: 21.8rem;
    aspect-ratio: 79/72;
  }

  .talk-to-us-intro {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    flex-direction: row;
    gap: 6rem;
  }

  .talk-to-us-calls {
    position: relative;

    margin: 0 0 0 -7rem;
    padding: 2.1rem 0 12.8rem 1.2rem;
  }

  .talk-to-us-calls-content {
    position: absolute;
    right: 3.1rem;
    top: -6.8rem;

    z-index: 20;

    max-width: 47%;

    box-shadow: var(--small-shadow);
  }

  .talk-to-us-call--coffee {
    margin: 0 -1.65rem 0 0;
    padding: 3.6rem 60% 0.6rem 6.8rem;

    &::before {
      @extend .tape;

      width: 2.5rem;
      height: 11.6rem;

      top: 1.4rem;
      left: -0.75rem;
    }

    &::after {
      aspect-ratio: 78 / 10;
      transform: translateY(100%) scaleX(-1);
    }
  }

  .talk-to-us-buy-us {
    margin: 3.6rem 3rem 0 0;
  }

  .talk-to-us-buy-us-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
}
