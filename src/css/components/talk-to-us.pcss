.talk-to-us {
  & .site-content-container {
    &::after {
      display: none;
    }
  }

  & .site-content {
    padding-bottom: 0;
  }

  & .site-content-container {
    margin-bottom: 0;
  }

  & .site-content-wrapper {
    padding-top: 2.75rem;
    padding-bottom: 3.4rem;

    & p {
      font-family: var(--base-font-mono);
      font-size: 0.875rem;
      font-weight: 400;
      line-height: normal;
      margin: 0 0 1rem;

      &:last-child {
        margin: 0;
      }
    }

    a:not([class]) {
      color: var(--text-accent);
    }
  }
}

.talk-to-us-hero {
  margin: 0 0 1rem;
}

.talk-to-us-hero-title {
  margin: 0 0 0.35rem 0;

  width: 16.7rem;
  height: 2.9rem;

  background-image: url("../images/talk-to-us-title.png");
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.talk-to-us-hero-illustration {
  width: 15.75rem;
  height: 14.3rem;
  aspect-ratio: 252/229;
  margin: 0 0 0 auto;
  mix-blend-mode: multiply;
}

.talk-to-us-title {
  margin: 0 0 1rem;

  font-family: var(--base-font-mono);
  font-size: 1rem;
  font-weight: 500;
  line-height: normal;
  text-transform: uppercase;
}

.talk-to-us-intro {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.talk-to-us-calls {
  margin: 0 -2.5rem 6.1rem 0;
  padding: 1rem;
  background-color: var(--bg-senary);
  box-shadow: var(--small-shadow);

  & .embossing-tape-title {
    transform: rotate(-0.884deg);
  }
}

.talk-to-us-calls-content {
  padding: 1.7rem 1.8rem 2.7rem;
  background-color: var(--bg-content);

  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.talk-to-us-call--coffee {
  position: relative;

  margin: -1.9rem -2rem 0 1rem;
  padding: 1.9rem 2rem 1.1rem 1rem;

  border-radius: 0.0625rem;
