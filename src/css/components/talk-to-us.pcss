.talk-to-us {
  & .site-content-container {
    &::after {
      display: none;
    }
  }

  & .site-content {
    padding-bottom: 0;
  }

  & .site-content-container {
    margin-bottom: 0;
  }

  & .site-content-wrapper {
    padding-top: 2.75rem;
    padding-bottom: 3.4rem;

    & p {
      font-family: var(--base-font-mono);
      font-size: 0.875rem;
      font-weight: 400;
      line-height: normal;
      margin: 0 0 1rem;

      &:last-child {
        margin: 0;
      }
    }

    a:not([class]) {
      color: var(--text-accent);
    }
  }
}

.talk-to-us-hero {
  margin: 0 0 1rem;
}

.talk-to-us-hero-title {
  margin: 0 0 0.35rem 0;

  width: 16.7rem;
  height: 2.9rem;

  background-image: url("../images/talk-to-us-title.png");
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.talk-to-us-hero-illustration {
  width: 15.75rem;
  height: 14.3rem;
  aspect-ratio: 252/229;
  margin: 0 0 0 auto;
  mix-blend-mode: multiply;
}

.talk-to-us-title {
  margin: 0 0 1rem;

  font-family: var(--base-font-mono);
  font-size: 1rem;
  font-weight: 500;
  line-height: normal;
  text-transform: uppercase;
}

.talk-to-us-intro {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.talk-to-us-calls {
  margin: 0 -2.5rem 6.1rem 0;
  padding: 1rem;
  background-color: var(--bg-senary);
  box-shadow: var(--small-shadow);

  & .embossing-tape-title {
    transform: rotate(-0.884deg);
  }
}

.talk-to-us-calls-content {
  padding: 1.7rem 1.8rem 2.7rem;
  background-color: var(--bg-content);

  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.talk-to-us-call--coffee {
  position: relative;

  margin: -1.9rem -2rem 0 1rem;
  padding: 1.9rem 2rem 1.1rem 1rem;

  border-radius: 0.0625rem;
  background-color: var(--bg-quinary);

  &::after {
    @extend .torn-paper;
    left: 0;
    bottom: 1px;
    width: 100%;
    aspect-ratio: 390 / 138;
    transform: translateY(100%);

    background-color: var(--bg-quinary);
  }
}

@media (--desktop) {
  .talk-to-us {
    & .site-content-wrapper {
      padding-top: 3.5rem;
    }
  }

  .talk-to-us-title {
    font-size: 1.5rem;
    font-weight: 400;
    text-transform: none;
  }

  .talk-to-us-hero {
    position: relative;
    padding-bottom: 11.5rem;
  }

  .talk-to-us-hero-title {
    width: 34.4rem;
    height: 7.1rem;

    margin-bottom: 2.9rem;
  }

  .talk-to-us-hero-illustration {
    position: absolute;
    left: -1rem;
    bottom: 0;

    width: 24rem;
    height: 21.8rem;
    aspect-ratio: 79/72;
  }

  .talk-to-us-intro {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    flex-direction: row;
    gap: 6rem;
  }

  .talk-to-us-calls {
    position: relative;

    margin: 0 0 0 -7rem;
    padding: 2.1rem 0 12.8rem 1.2rem;
  }

  .talk-to-us-calls-content {
    position: absolute;
    right: 3.1rem;
    top: -6.8rem;

    z-index: 20;

    max-width: 47%;

    box-shadow: var(--small-shadow);
  }

  .talk-to-us-call--coffee {
    margin: 0 -1.65rem 0 0;
    padding: 3.6rem 60% 0.6rem 6.8rem;

    &::before {
      @extend .tape;

      width: 2.5rem;
      height: 11.6rem;

      top: 1.4rem;
      left: -0.75rem;
    }

    &::after {
      aspect-ratio: 78 / 10;
      transform: translateY(100%) scaleX(-1);
    }
  }

  .talk-to-us-buy-us {
    margin: 3.6rem 3rem 0 0;
  }

  .talk-to-us-buy-us-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
}
