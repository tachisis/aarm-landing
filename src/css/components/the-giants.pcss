      width: 14.3rem;
      aspect-ratio: 10/13;
      transform: rotate(1.189deg);

      &::after {
        right: 0.4rem;
      }
    }

    & .the-giants-links {
      position: absolute;
      top: 25.8rem;
      left: 76%;
    }
  }

  .the-giants-profile--sutherland {
