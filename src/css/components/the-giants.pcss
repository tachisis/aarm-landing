      19.12% 9.02%,
      21.12% 9.5%,
      22.37% 10.19%,
      23.11% 10.92%,
      23.57% 11.48%,
      24.11% 12.39%,
      24.53% 13.62%,
      24.86% 14.77%,
      25.16% 15.44%,
      25.76% 16.82%,
      26.4% 19.08%,
      27.03% 21.2%,
      27.6% 22.15%,
      27.85% 21.67%,
      28.16% 20.59%,
      28.62% 19.44%,
      29.35% 18.73%,
      30.31% 18.56%,
      31.45% 18.55%,
      32.6% 18.67%,
      33.58% 18.86%,
      34.26% 19.11%,
      34.66% 19.45%,
      34.88% 19.87%,
      34.99% 20.36%,
      35.37% 22.61%,
      35.69% 24.9%,
      35.95% 26.87%,
      36.16% 28.15%,
      36.31% 28.08%,
      36.42% 26.87%,
      36.52% 25.24%,
      36.59% 23.93%,
      36.82% 23.17%,
      37.14% 24.19%,
      37.51% 25.72%,
      37.86% 26.52%,
      38.32% 26.14%,
      38.73% 25.25%,
      39.11% 24.27%,
      39.5% 23.64%,
      39.95% 23.82%,
      40.47% 24.78%,
      41.09% 26.23%,
      41.84% 27.87%,
      42.9% 29.85%,
      43.8% 31.17%,
      44.72% 32.14%,
      45.83% 33.07%,
      46.21% 33.69%,
      46.56% 34.87%,
      46.91% 36.59%,
      47.29% 38.81%,
      47.73% 41.09%,
      48.3% 43.64%,
      48.99% 46.41%,
      49.8% 49.32%,
      50.91% 52.93%,
      51.68% 54.99%,
      52.22% 56.14%,
      52.67% 57%,
      53.07% 57.17%,
      53.54% 56.43%,
      54.16% 55.37%,
      54.98% 54.54%,
      55.58% 54.27%,
      56.1% 54.28%,
      56.56% 54.76%,
      56.99% 55.9%,
      57.07% 56.12%,
      57.14% 56.08%,
      57.2% 55.68%,
      57.24% 54.83%,
      57.27% 53.48%,
      57.29% 51.86%,
      57.31% 50.26%,
      57.34% 48.97%,
      57.38% 48.21%,
      57.44% 47.93%,
      57.51% 47.99%,
      57.59% 48.25%,
      58.19% 49.73%,
      58.95% 50.48%,
      59.86% 50.57%,
      60.9% 50.04%,
      61.1% 49.3%,
      61.21% 47.82%,
      61.26% 46.08%,
      61.32% 44.57%,
      61.87% 42.68%,
      62.89% 43.18%,
      64.09% 44.88%,
      65.16% 46.6%,
      65.07% 47.23%,
      64.61% 48.49%,
      63.9% 50.04%,
      63.03% 51.52%,
      62.81% 52.1%,
      62.72% 52.85%,
      62.73% 53.62%,
      62.79% 54.26%,
      63.13% 55.71%,
      63.6% 56.37%,
      64.26% 56.66%,
      65.12% 57%,
      66.52% 57.22%,
      67.7% 56.53%,
      68.58% 55.26%,
      69.11% 53.73%,
      69.61% 52.64%,
      70.39% 52.08%,
      71.27% 51.66%,
      72.1% 50.99%,
      72.56% 50.92%,
      72.99% 51.63%,
      73.38% 52.78%,
      73.7% 53.99%,
      74.05% 55.28%,
      74.46% 56.61%,
      74.89% 57.85%,
      75.33% 58.91%,
      75.44% 58.8%,
      75.51% 58.09%,
      75.56% 57.15%,
      75.6% 56.34%,
      76.18% 55.03%,
      77.2% 56.49%,
      78.52% 58.99%,
      80.01% 60.83%,
      80.49% 61.07%,
      80.88% 61.13%,
      81.2% 61.01%,
      81.49% 60.69%,
      82.31% 62.13%,
      83.35% 66.99%,
      84.54% 72.93%,
      85.82% 77.64%,
      86.8% 78.71%,
      87.82% 77.84%,
      88.75% 75.96%,
      89.48% 73.96%,
      90.28% 72.62%,
      90.82% 73.31%,
      91.15% 74.7%,
      91.33% 75.46%,
      91.43% 74.97%,
      91.54% 73.76%,
      91.67% 72.24%,
      91.85% 70.82%,
      92.04% 70.41%,
      92.39% 70.93%,
      93% 72.78%,
      94% 76.35%,
      95.41% 81.86%,
      97.06% 88.44%,
      98.67% 94.87%,
      100% 99.95%,
      100% 0%,
      0% 0%
    );
  }
}

.the-giants-hero-title {
  margin: 0 0 3.2rem;

  width: 15.87894rem;
  height: 6.89625rem;

  background-image: url("../images/the-giants-title.png");
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.the-giants-hero-text {
  margin: 0 auto;

  text-align: left;

  & p {
    margin: 0 0 1rem;

    font-size: 0.875rem;
    line-height: normal;
  }

  & p:last-child {
    margin-bottom: 0;
  }
}

.the-giants-hero-quote {
  margin: 0.35rem 0 0.8rem;
  padding: 0;

  border: 0;

  font-size: 1.5rem;
  font-style: italic;
  font-weight: 500;
  line-height: normal;

  & p {
    margin: 0;
    font-size: inherit;
  }
}

.the-giants-profile {
  margin-top: 2rem;
}

.the-giants-portrait {
  width: 12.5rem;
  height: auto;

  margin-bottom: 1rem;
}

.the-giants-links {
  margin: 0 0 2rem;
  padding: 0 0 0 1.1rem;

  color: var(--text-accent);

  font-size: 0.75rem;
  font-style: normal;
  font-weight: 500;
  line-height: normal;
}

.the-giants-links--no-markers {
  padding-left: 0;
  list-style: none;
}

.the-giants-name {
  margin-bottom: 0.5rem;

  font-family: var(--base-font-mono);
  font-size: 1.5rem;
  font-weight: 500;
  line-height: normal;
  text-transform: uppercase;
}

.the-giants-bio {
  & p {
    font-family: var(--base-font-mono);
    font-size: 0.875rem;
    line-height: normal;
    margin: 0 0 1rem;
  }

  & p:last-child {
    margin-bottom: 0;
  }

  & a:not([class]) {
    color: var(--text-accent);
  }
}

.the-giants-profile--kay {
  margin-bottom: 5.6rem;

  & .the-giants-portrait {
    position: relative;

    margin-bottom: 3.5rem;

    transform: rotate(0.08deg);

    &::before {
      content: "";
      position: absolute;
      left: 1.4rem;
      top: -1.2rem;
      width: 4.875rem;
      height: 2.5625rem;
      opacity: 0.3;
      background: var(--bg-nonary);
    }

    &::after {
      content: "";
      position: absolute;
      right: -1rem;
      bottom: -1.5rem;
      width: 11.6875rem;
      height: 2.5625rem;
      opacity: 0.3;
      background: var(--bg-nonary);
    }
  }
}

.the-giants-profile--victor {
  margin: 0 -2rem 0 -1.6rem;

  &::before {
    content: "";
    position: absolute;
    left: 1.5rem;
    top: 0.8rem;

    width: 100%;
    height: 20%;

    background-color: var(--bg-quinary);
    box-shadow: var(--base-shadow);

    z-index: 10;

    border-radius: 0.125rem;
  }

  &.folder {
    padding-top: 4.6rem;
  }

  .the-giants-profile-content {
    position: relative;
    z-index: 20;

    margin: 0 -0.6rem 0 -2.1rem;
    padding: 14.2rem 2.5rem 2.4rem 3.6rem;

    background-color: var(--bg-content);
    color: var(--text-primary);

    box-shadow: var(--small-shadow);

    border-radius: 0.25rem;
  }

  .the-giants-portrait {
    position: absolute;
    top: -3rem;
    right: 2rem;

    width: 12.5rem;
    height: 15.625rem;
    transform: rotate(0.08deg);
    aspect-ratio: 4/5;

    &::before {
      position: absolute;
      top: -0.6rem;
      right: 1.1rem;
      z-index: 20;

      content: "";

      display: block;
      width: 1.467rem;
      height: 5.98763rem;
      transform: rotate(6.162deg);

      background: url("../images/clip-3.svg") no-repeat;
      background-size: contain;
    }
  }

  .the-giants-bio {
    & p {
      font-family: var(--base-font-sans);
    }
  }
}

.the-giants-profile--mcilroy {
  margin-bottom: 2.5rem;

  & .the-giants-portrait {
    position: relative;

    width: 19rem;
    margin: 0 0 2rem -1.8rem;
    transform: rotate(-1.922deg);

    background-color: var(--bg-content);

    padding: 1.5rem;

    border-radius: 0.08881rem;
    box-shadow: var(--small-shadow);

    &::before {
      content: "";
      display: block;
      width: 4.2rem;
      height: 4rem;
      transform: rotate(-170deg);
      position: absolute;
      top: -1.1rem;
      left: -2.3rem;
      background: url("../images/clip-1.svg") no-repeat left top;
      background-size: 100% 100%;
    }
  }
}

.the-giants-profile--rosenblatt {
  margin: 0 0 0 -2.7rem;
  padding: 2.2rem 1rem 3rem 2.7rem;

  background-color: var(--bg-quinary);
  box-shadow: var(--small-shadow);

  & .the-giants-portrait {
    position: relative;

    margin-bottom: 5.4rem;

    width: 14.375rem;
    height: 18.6875rem;
    aspect-ratio: 10/13;

    mix-blend-mode: multiply;

    &::before {
      content: "";
      position: absolute;
      left: 1.4rem;
      top: -1.2rem;
      width: 11.6875rem;
      height: 2.5625rem;
      opacity: 0.3;
      background: var(--bg-nonary);
    }

    &::after {
      content: "";
      position: absolute;
      right: -1rem;
      bottom: -1.5rem;
      width: 11.6875rem;
      height: 2.5625rem;
      opacity: 0.3;
      background: var(--bg-nonary);
    }
  }

  .the-giants-bio {
    & p {
      font-family: var(--base-font-sans);
    }
  }
}

.the-giants-profile--sutherland {
  margin-top: 2.3rem;

  & .the-giants-portrait {
    width: 14.375rem;
    height: 18.6875rem;
    aspect-ratio: 10/13;
  }

  & .the-giants-name {
    padding-right: 40%;
  }
}

.the-giants-profile--alexander {
  position: relative;
  margin: 2.5rem -2rem 0 -2.5rem;
  padding: 3.2rem 1.8rem 4.9rem 2.9rem;

  background-color: var(--bg-denary);
  box-shadow: var(--xsmall-shadow);

  & .the-giants-portrait {
    position: relative;

    width: calc(100% + 2.9rem);
    margin: 0 0 1.5rem -2.9rem;
    padding: 5.6rem 0 1rem 5rem;

    background-color: var(--bg-quinary);
    box-shadow: var(--small-shadow);

    & img {
      width: 13rem;
      height: 16.3125rem;
      aspect-ratio: 51/64;
    }

    &::before {
      content: "";
      position: absolute;
      left: 1rem;
      top: -3rem;
      width: 1.92352rem;
      height: 19.14095rem;
      background: url("../images/folder-clip.svg") no-repeat center center;
      background-size: contain;
    }
  }

  .the-giants-links {
    font-size: 0.875rem;
    font-weight: 400;
  }

  .the-giants-name {
    position: absolute;
    top: 4.4rem;
    left: 5.8rem;

    max-width: 10rem;

    font-family: var(--font-aaic);
    font-size: var(--text-3xl);
    line-height: normal;
    letter-spacing: -0.04em;
    text-transform: none;
    text-decoration: none;

    color: var(--text-accent);
  }

  .the-giants-bio {
    & p {
      font-family: var(--base-font-sans);
    }
  }
}

.the-giants-profile--kripke {
  margin-top: 4rem;

  & .the-giants-portrait {
    position: relative;

    width: 12.5625rem;
    height: 15.6875rem;
    margin: 0 0 2rem 1.25rem;
    aspect-ratio: 197/246;

    &::before {
      content: "";
      position: absolute;
      left: -1.25rem;
      top: 0.75rem;
      height: 4.8rem;
      width: 2.5rem;
      opacity: 0.3;
      background: var(--bg-nonary);
    }

    &::after {
      content: "";
      position: absolute;
      right: -1.25rem;
      bottom: -1.1rem;
      width: 2.5rem;
      height: 11.6rem;
      opacity: 0.3;
      background: var(--bg-nonary);
    }
  }
}

.the-giants-profile--altshuller {
  margin: 3rem 0 0 -2.7rem;
  padding: 2.3rem 1rem 2.7rem 3.1rem;

  background-color: var(--bg-eleventh);
  box-shadow: var(--small-shadow);

  & .the-giants-portrait {
    margin: 0 0 1.6rem -0.1rem;

    width: 14.375rem;
    height: 18.6875rem;
    aspect-ratio: 10/13;
  }

  & .the-giants-bio {
    & p {
      font-family: var(--base-font-sans);
    }
  }
}

.the-giants-profile--gang-of-four {
  margin: 1.6rem 0 0;

  & .the-giants-portrait {
    position: relative;

    width: 13.3125rem;
    height: 9.375rem;
    aspect-ratio: 71/50;

    margin-bottom: 1.1rem;

    &::before {
      content: "";

      position: absolute;
      left: -1.7rem;
      bottom: 0.4rem;

      height: 3.4rem;
      width: 2.5rem;

      opacity: 0.3;
      background: var(--bg-nonary);
    }
  }
}

.the-giants-profile--huizinga {
  position: relative;

  padding: 22rem 0.75rem 8.8rem 0;
  margin: 3rem -0.5rem 0;

  background-color: var(--bg-quinary);
  box-shadow: var(--small-shadow);

  & .the-giants-profile-content {
    --ring-tile: 1.6rem;
    --ring-hole-r: 0.408rem;
    --ring-stem-w: 0.156rem;
    --ring-stem-l: 0.85rem;
    --ring-edge-h: calc(var(--ring-stem-l) + 2 * var(--ring-hole-r));

    position: absolute;
    left: -3.7rem;
    right: 0.75rem;
    top: 1.8rem;

    width: calc(100% - 0.75rem + 3.7rem);
    height: calc(100% - 1.8rem - 5.8rem);

    transform: rotate(-0.804deg);

    background-color: var(--bg-content);
    box-shadow: var(--small-shadow);

    &::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;

      height: var(--ring-edge-h);
      pointer-events: none;

      background-image:
        radial-gradient(
          circle var(--ring-hole-r) at 50% var(--ring-hole-r),
          var(--bg-quinary) 98.5%,
          transparent 100%
        ),
        repeating-linear-gradient(
          90deg,
          transparent 0 calc(var(--ring-tile) / 2 - var(--ring-stem-w) / 2),
          var(--bg-quinary) calc(var(--ring-tile) / 2 - var(--ring-stem-w) / 2)
            calc(var(--ring-tile) / 2 + var(--ring-stem-w) / 2),
          transparent calc(var(--ring-tile) / 2 + var(--ring-stem-w) / 2)
            var(--ring-tile)
        );
      background-size:
        var(--ring-tile) 100%,
        var(--ring-tile) var(--ring-stem-l);
      background-position:
        0 0,
        0 100%;
      background-repeat: repeat-x, repeat-x;
    }
  }

  & .the-giants-portrait {
    position: absolute;
    top: 0.7rem;
    right: -0.6rem;

    width: 12.5rem;
    height: 17.9rem;
    aspect-ratio: 201/287;

    &::before {
      position: absolute;
      top: -0.6rem;
      right: 1.1rem;
      z-index: 20;

      content: "";

      display: block;
      width: 1.467rem;
      height: 5.98763rem;
      transform: rotate(6.162deg);

      background: url("../images/clip-3.svg") no-repeat;
      background-size: contain;
    }
  }

  & .the-giants-name {
    position: relative;
  }

  & .the-giants-links {
    position: relative;
  }

  & .the-giants-bio {
    position: relative;

    padding-right: 1.75rem;

    & p {
      font-family: var(--base-font-sans);
    }
  }
}

.the-giants-profile--vygotsky {
  margin: 2.5rem 0 0;
  padding: 0 0 0.8rem;

  & .the-giants-portrait {
    position: relative;

    width: 16.375rem;
    height: 23.375rem;
    aspect-ratio: 131/187;

    margin: 0 0 1.6rem -1.1rem;

    &::before {
      content: "";
      display: block;

      width: 5.8rem;
      height: 5.5rem;
      transform: rotate(-194deg);

      position: absolute;
      bottom: 1.5rem;
      left: -4.3rem;

      background: url("../images/clip-1.svg") no-repeat left top;
      background-size: 100% 100%;
    }
  }
}

@media (--desktop) {
  .the-giants {
    background-image:
      url("../images/main-bg-1.png"), url("../images/main-bg-1.png");
    background-repeat: no-repeat, no-repeat;
    background-size:
      18.90625rem 10.625rem,
      18.90625rem 10.625rem;
    background-position:
      calc(50% - 42rem) 15rem,
      calc(50% + 42rem) 35rem;

    & .site-header-wrap {
      margin-bottom: 4.4rem;
    }

    & .site-content-container {
      &::after {
        display: none;
      }
    }
  }

  .the-giants-hero {
    margin: -2.8rem 0 2.75rem;
    padding: 3.3rem 0 6rem 2.2rem;

    &::before {
      top: -10.5rem;
      width: 2.5625rem;
      height: 25.5rem;
    }

    &::after {
      aspect-ratio: 72 / 10;
    }

    & .the-giants-hero-text {
      position: absolute;
      top: 8.4rem;
      left: 38%;

      max-width: 60%;

      display: flex;
      gap: 2.3rem;

      z-index: 20;

      & > div {
        flex: 0 0 54%;
      }

      & a:not([class]) {
        color: var(--text-accent);
      }

      & p {
        font-size: 1rem;
      }

      & .the-giants-hero-quote p {
        padding-right: 2rem;
        font-size: 2rem;
      }
    }
  }

  .the-giants-hero-title {
    width: 19.75rem;
    height: 8.5625rem;
  }

  .the-giants-name {
    margin-bottom: 1.4rem;
  }

  .the-giants-profile--kay {
    position: relative;
    padding: 2.5rem 30% 0 0;

    & .the-giants-portrait {
      position: absolute;
      top: 5.7rem;
      left: 70%;
    }

    & .the-giants-links {
      position: absolute;
      top: 25rem;
      left: 70%;

      max-width: 12rem;
    }
  }

  .the-giants-profile--victor {
    margin: 0 -4.5rem 0 1.3rem;

    &.folder {
      padding: 2.8rem 2.6rem 3.1rem 0;

      filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.15));
    }

    &::before {
      left: 3.6rem;
      right: 8.6rem;
      bottom: 1.6rem;

      width: auto;
      height: auto;
    }

    &::after {
      content: "";
      position: absolute;
      top: 2.3rem;
      left: 0;
      right: 0.5rem;
      bottom: 0;

      background: url(../images/specialisms-03-bg.svg) no-repeat center / 100%
        100%;
      filter: drop-shadow(0 -10px 17px rgba(0, 0, 0, 0.25));
    }

    & .the-giants-profile-content {
      position: relative;
      margin: 0 0 0 -1rem;
      padding: 4.2rem 30% 3.6rem 5rem;

      transform: rotate(-1.191deg);

      &::before {
        content: "";
        position: absolute;
        left: 2rem;
        top: 10.31rem;
        width: 1rem;
        height: 15.625rem;
        background:
          radial-gradient(
            circle 0.5rem at 0.5rem 0.5rem,
            var(--bg-quaternary) 99%,
            transparent 100%
          ),
          radial-gradient(
            circle 0.5rem at 0.5rem calc(100% - 0.5rem),
            var(--bg-quaternary) 99%,
            transparent 100%
          );
        background:
          radial-gradient(
            circle 0.5rem at 0.5rem 0.5rem,
            var(--bg-quaternary) 99%,
            transparent 100%
          ),
          radial-gradient(
            circle 0.5rem at 0.5rem calc(100% - 0.5rem),
            var(--bg-quaternary) 99%,
            transparent 100%
          );
        background-repeat: no-repeat;
      }

      &::after {
        content: "";

        display: block;

        width: 14.5rem;
        height: 9.5625rem;

        transform: rotate(180deg);
        aspect-ratio: 185/122;

        background: url(../images/mark.png) no-repeat center bottom;
        background-size: 100% auto;

        mix-blend-mode: multiply;

        position: absolute;
        bottom: 0;
        right: 2.12rem;
        z-index: 20;
      }
    }

    & .the-giants-portrait {
      width: 12.5rem;

      top: -0.3rem;

      transform: rotate(0.08deg);
    }

    .the-giants-links {
      position: absolute;
      top: 16rem;
      right: 1.6rem;

      max-width: 13rem;

      transform: rotate(-1.191deg);
    }
  }

  .the-giants-profile--mcilroy {
    position: relative;
    margin: 6.2rem 0 0;
    padding: 0 0 5.8rem 26%;

    & .the-giants-portrait {
      position: absolute;
      top: 0;
      left: -4.7rem;

      width: 18rem;
      transform: rotate(-1.922deg);

      &::before {
        width: 5.8rem;
        height: 5.5rem;

        left: -3.4rem;
      }
    }

    & .the-giants-links {
      position: absolute;
      top: 24.8rem;
      left: 0;
    }
  }

