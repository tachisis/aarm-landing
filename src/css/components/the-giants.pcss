  .the-giants-profile--alexander {
    margin: 3.2rem -6rem 0 0;

    padding: 4.6rem 6.5rem 6.1rem 30%;

    & .the-giants-portrait {
      position: absolute;
      top: 2.6rem;
      left: 0.8rem;
      margin: 0;

      max-width: 17.1rem;

      & img {
        position: relative;
        right: -0.5rem;
      }

      &::before {
        width: 2.5rem;
        height: 25.5rem;
      }
    }

    & .the-giants-links {
      position: absolute;
      top: 26.8rem;
