.the-giants-hero {
  position: relative;
  z-index: 0;

  margin: -2.1rem 0 2.75rem;
  padding: 4.9rem 1rem 6.7rem;

  background: var(--bg-senary);
  box-shadow: 0 1px 4px 0 rgba(0, 0, 0, 0.15);

  &::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -7.6rem;

    width: 1.92352rem;
    height: 19.14095rem;

    background: url("../images/folder-clip.svg") no-repeat center center;
    background-size: contain;

    transform: translateX(-50%) rotate(90deg);
    transform-origin: center center;
  }

  &::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 1px;
    width: 100%;
    aspect-ratio: 19 / 5;
    pointer-events: none;
    transform: translateY(100%);
    z-index: 10;

    background-color: var(--bg-senary);
    filter: drop-shadow(0 5px 6px rgba(0, 0, 0, 0.14));

    clip-path: polygon(
      0% 2.18%,
      0.47% 1.95%,
      1.65% 1.56%,
      3.14% 1.49%,
      4.59% 2.17%,
      5.43% 3.24%,
      6.06% 4.46%,
      6.62% 5.7%,
      7.22% 6.83%,
