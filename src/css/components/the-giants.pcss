.the-giants-hero {
  position: relative;
  z-index: 0;

  margin: -2.1rem 0 2.75rem;
  padding: 4.9rem 1rem 6.7rem;

  background: var(--bg-senary);
  box-shadow: 0 1px 4px 0 rgba(0, 0, 0, 0.15);

  &::before {
    @extend .folder-clip;
    left: 50%;
    top: -7.6rem;

    width: 1.9rem;
    height: 19.1rem;

    transform: translateX(-50%) rotate(90deg);
    transform-origin: center center;
  }

  &::after {
    @extend .torn-paper;

    left: 0;
    bottom: 1px;
    width: 100%;
    aspect-ratio: 19 / 5;
    transform: translateY(100%);

    background-color: var(--bg-senary);
  }
}

.the-giants-hero-title {
  margin: 0 0 3.2rem;

  width: 15.87894rem;
  height: 6.89625rem;

  background-image: url("../images/the-giants-title.png");
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.the-giants-hero-text {
  margin: 0 auto;

  text-align: left;

  & p {
    margin: 0 0 1rem;

    font-size: 0.875rem;
    line-height: normal;
  }

  & p:last-child {
    margin-bottom: 0;
  }
}

.the-giants-hero-quote {
  margin: 0.35rem 0 0.8rem;
  padding: 0;

  border: 0;

  font-size: 1.5rem;
  font-style: italic;
  font-weight: 500;
  line-height: normal;

  & p {
    margin: 0;
    font-size: inherit;
  }
}

.the-giants-profile {
  margin-top: 2rem;
}

.the-giants-portrait {
  width: 12.5rem;
  height: auto;

  margin-bottom: 1rem;
}

.the-giants-links {
  margin: 0 0 2rem;
  padding: 0 0 0 1.1rem;

  color: var(--text-accent);

  font-size: 0.75rem;
  font-style: normal;
  font-weight: 500;
  line-height: normal;
}

.the-giants-links--no-markers {
  padding-left: 0;
  list-style: none;
}

.the-giants-name {
  margin-bottom: 0.5rem;

  font-family: var(--base-font-mono);
  font-size: 1.5rem;
  font-weight: 500;
  line-height: normal;
  text-transform: uppercase;
}

.the-giants-bio {
  & p {
    font-family: var(--base-font-mono);
    font-size: 0.875rem;
    line-height: normal;
    margin: 0 0 1rem;
  }

  & p:last-child {
    margin-bottom: 0;
  }

  & a:not([class]) {
    color: var(--text-accent);
  }
}

.the-giants-profile--kay {
  margin-bottom: 5.6rem;

  & .the-giants-portrait {
    position: relative;

    margin-bottom: 3.5rem;

    transform: rotate(0.08deg);

    &::before {
      @extend .tape;
      left: 1.4rem;
      top: -1.2rem;
      width: 4.875rem;
      height: 2.5625rem;
    }

    &::after {
      @extend .tape;
      right: -1rem;
      bottom: -1.5rem;
      width: 11.6875rem;
      height: 2.5625rem;
    }
  }
}

.the-giants-profile--victor {
  margin: 0 -2rem 0 -1.6rem;

  &::before {
    content: "";
    position: absolute;
    left: 1.5rem;
    top: 0.8rem;

    width: 100%;
    height: 20%;

    background-color: var(--bg-quinary);
    box-shadow: var(--base-shadow);

    z-index: 10;

    border-radius: 0.125rem;
  }

  &.folder {
    padding-top: 4.6rem;
  }

  .the-giants-profile-content {
    position: relative;
    z-index: 20;

    margin: 0 -0.6rem 0 -2.1rem;
    padding: 14.2rem 2.5rem 2.4rem 3.6rem;

    background-color: var(--bg-content);
    color: var(--text-primary);

    box-shadow: var(--small-shadow);

    border-radius: 0.25rem;
  }

  .the-giants-portrait {
    position: absolute;
    top: -3rem;
    right: 2rem;

    width: 12.5rem;
    height: 15.625rem;
    transform: rotate(0.08deg);
    aspect-ratio: 4/5;

    &::before {
      @extend .clip-2;
      top: -0.6rem;
      right: 1.1rem;
      z-index: 20;

      width: 1.467rem;
      height: 5.9rem;
      transform: rotate(6.162deg);
    }
  }

  .the-giants-bio {
    & p {
      font-family: var(--base-font-sans);
    }
  }
}

.the-giants-profile--mcilroy {
  margin-bottom: 2.5rem;

  & .the-giants-portrait {
    position: relative;

    width: 19rem;
    margin: 0 0 2rem -1.8rem;
    transform: rotate(-1.922deg);

    background-color: var(--bg-content);

    padding: 1.5rem;

    border-radius: 0.08881rem;
    box-shadow: var(--small-shadow);

    &::before {
      @extend .clip-1;
      width: 4.2rem;
      height: 4rem;
      transform: rotate(-170deg);
      top: -1.1rem;
      left: -2.3rem;
    }
  }
}

.the-giants-profile--rosenblatt {
  margin: 0 0 0 -2.7rem;
  padding: 2.2rem 1rem 3rem 2.7rem;

  background-color: var(--bg-quinary);
  box-shadow: var(--small-shadow);

  & .the-giants-portrait {
    position: relative;

    margin-bottom: 5.4rem;

    width: 14.375rem;
    height: 18.6875rem;
    aspect-ratio: 10/13;

    mix-blend-mode: multiply;

    &::before {
      @extend .tape;
      left: 1.4rem;
      top: -1.2rem;
      width: 11.6875rem;
      height: 2.5625rem;
    }

    &::after {
      @extend .tape;
      right: -1rem;
      bottom: -1.5rem;
      width: 11.6875rem;
      height: 2.5625rem;
    }
  }

  .the-giants-bio {
    & p {
      font-family: var(--base-font-sans);
    }
  }
}

.the-giants-profile--sutherland {
  margin-top: 2.3rem;

  & .the-giants-portrait {
    width: 14.375rem;
    height: 18.6875rem;
    aspect-ratio: 10/13;
  }

  & .the-giants-name {
    padding-right: 40%;
  }
}

.the-giants-profile--alexander {
  position: relative;
  margin: 2.5rem -2rem 0 -2.5rem;
  padding: 3.2rem 1.8rem 4.9rem 2.9rem;

  background-color: var(--bg-denary);
  box-shadow: var(--xsmall-shadow);

  & .the-giants-portrait {
    position: relative;

    width: calc(100% + 2.9rem);
    margin: 0 0 1.5rem -2.9rem;
    padding: 5.6rem 0 1rem 5rem;

    background-color: var(--bg-quinary);
    box-shadow: var(--small-shadow);

    & img {
      width: 13rem;
      height: 16.3125rem;
      aspect-ratio: 51/64;
    }

    &::before {
      @extend .folder-clip;
      left: 1rem;
      top: -3rem;
      width: 1.9rem;
      height: 19.1rem;
    }
  }

  .the-giants-links {
    font-size: 0.875rem;
    font-weight: 400;
  }

  .the-giants-name {
    position: absolute;
    top: 4.4rem;
    left: 5.8rem;

    max-width: 10rem;

    font-family: var(--font-aaic);
    font-size: var(--text-3xl);
    line-height: normal;
    letter-spacing: -0.04em;
    text-transform: none;
    text-decoration: none;

    color: var(--text-accent);
  }

  .the-giants-bio {
    & p {
      font-family: var(--base-font-sans);
    }
  }
}

.the-giants-profile--kripke {
  margin-top: 4rem;

  & .the-giants-portrait {
    position: relative;

    width: 12.5625rem;
    height: 15.6875rem;
    margin: 0 0 2rem 1.25rem;
    aspect-ratio: 197/246;

    &::before {
      @extend .tape;
      left: -1.25rem;
      top: 0.75rem;
      height: 4.8rem;
      width: 2.5rem;
    }

    &::after {
      @extend .tape;
      right: -1.25rem;
      bottom: -1.1rem;
      width: 2.5rem;
      height: 11.6rem;
    }
  }
}

.the-giants-profile--altshuller {
  margin: 3rem 0 0 -2.7rem;
  padding: 2.3rem 1rem 2.7rem 3.1rem;

  background-color: var(--bg-eleventh);
  box-shadow: var(--small-shadow);

  & .the-giants-portrait {
    margin: 0 0 1.6rem -0.1rem;

    width: 14.375rem;
    height: 18.6875rem;
    aspect-ratio: 10/13;
  }

  & .the-giants-bio {
    & p {
      font-family: var(--base-font-sans);
    }
  }
}

.the-giants-profile--gang-of-four {
  margin: 1.6rem 0 0;

  & .the-giants-portrait {
    position: relative;

    width: 13.3125rem;
    height: 9.375rem;
    aspect-ratio: 71/50;

    margin-bottom: 1.1rem;

    &::before {
      @extend .tape;
      left: -1.7rem;
      bottom: 0.4rem;

      height: 3.4rem;
      width: 2.5rem;
    }
  }
}

.the-giants-profile--huizinga {
  position: relative;

  padding: 22rem 0.75rem 8.8rem 0;
  margin: 3rem -0.5rem 0;

  background-color: var(--bg-quinary);
  box-shadow: var(--small-shadow);

  & .the-giants-profile-content {
    --ring-tile: 1.6rem;
    --ring-hole-r: 0.408rem;
    --ring-stem-w: 0.156rem;
    --ring-stem-l: 0.85rem;
    --ring-edge-h: calc(var(--ring-stem-l) + 2 * var(--ring-hole-r));

    position: absolute;
    left: -3.7rem;
    right: 0.75rem;
    top: 1.8rem;

    width: calc(100% - 0.75rem + 3.7rem);
    height: calc(100% - 1.8rem - 5.8rem);

    transform: rotate(-0.804deg);

    background-color: var(--bg-content);
    box-shadow: var(--small-shadow);

    &::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;

      height: var(--ring-edge-h);
      pointer-events: none;

      background-image:
        radial-gradient(
          circle var(--ring-hole-r) at 50% var(--ring-hole-r),
          var(--bg-quinary) 98.5%,
          transparent 100%
        ),
        repeating-linear-gradient(
          90deg,
          transparent 0 calc(var(--ring-tile) / 2 - var(--ring-stem-w) / 2),
          var(--bg-quinary) calc(var(--ring-tile) / 2 - var(--ring-stem-w) / 2)
            calc(var(--ring-tile) / 2 + var(--ring-stem-w) / 2),
          transparent calc(var(--ring-tile) / 2 + var(--ring-stem-w) / 2)
            var(--ring-tile)
        );
      background-size:
        var(--ring-tile) 100%,
        var(--ring-tile) var(--ring-stem-l);
      background-position:
        0 0,
        0 100%;
      background-repeat: repeat-x, repeat-x;
    }
  }

  & .the-giants-portrait {
    position: absolute;
    top: 0.7rem;
    right: -0.6rem;

    width: 12.5rem;
    height: 17.9rem;
    aspect-ratio: 201/287;

    &::before {
      @extend .clip-2;
      top: -0.6rem;
      right: 1.1rem;
      z-index: 20;

      width: 1.4rem;
      height: 5.9rem;
      transform: rotate(6.162deg);
    }
  }

  & .the-giants-name {
    position: relative;
  }

  & .the-giants-links {
    position: relative;
  }

  & .the-giants-bio {
    position: relative;

    padding-right: 1.75rem;

    & p {
      font-family: var(--base-font-sans);
    }
  }
}

.the-giants-profile--vygotsky {
  margin: 2.5rem 0 0;
  padding: 0 0 0.8rem;

  & .the-giants-portrait {
    position: relative;

    width: 16.375rem;
    height: 23.375rem;
    aspect-ratio: 131/187;

    margin: 0 0 1.6rem -1.1rem;

    &::before {
      @extend .clip-1;
      width: 5.8rem;
      height: 5.5rem;
      transform: rotate(-194deg);

      bottom: 1.5rem;
      left: -4.3rem;
    }
  }
}

@media (--desktop) {
  .the-giants {
    background-image:
      url("../images/main-bg-1.png"), url("../images/main-bg-1.png");
    background-repeat: no-repeat, no-repeat;
    background-size:
      18.90625rem 10.625rem,
      18.90625rem 10.625rem;
    background-position:
      calc(50% - 42rem) 15rem,
      calc(50% + 42rem) 35rem;

    & .site-header-wrap {
      margin-bottom: 4.4rem;
    }

    & .site-content-container {
      &::after {
        display: none;
      }
    }
  }

  .the-giants-hero {
    margin: -2.8rem 0 2.75rem;
    padding: 3.3rem 0 6rem 2.2rem;

    &::before {
      top: -10.5rem;
      width: 2.5625rem;
      height: 25.5rem;
    }

    &::after {
      aspect-ratio: 72 / 10;
    }

    & .the-giants-hero-text {
      position: absolute;
      top: 8.4rem;
      left: 38%;

      max-width: 60%;

      display: flex;
      gap: 2.3rem;

      z-index: 20;

      & > div {
        flex: 0 0 54%;
      }

      & a:not([class]) {
        color: var(--text-accent);
      }

      & p {
        font-size: 1rem;
      }

      & .the-giants-hero-quote p {
        padding-right: 2rem;
        font-size: 2rem;
      }
    }
  }

  .the-giants-hero-title {
    width: 19.75rem;
    height: 8.5625rem;
  }

  .the-giants-name {
    margin-bottom: 1.4rem;
  }

  .the-giants-profile--kay {
    position: relative;
    padding: 2.5rem 30% 0 0;

    & .the-giants-portrait {
      position: absolute;
      top: 5.7rem;
      left: 70%;
    }

    & .the-giants-links {
      position: absolute;
      top: 25rem;
      left: 70%;

      max-width: 12rem;
    }
  }

  .the-giants-profile--victor {
    margin: 0 -4.5rem 0 1.3rem;

    &.folder {
      padding: 2.8rem 2.6rem 3.1rem 0;

      filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.15));
    }

    &::before {
      left: 3.6rem;
      right: 8.6rem;
      bottom: 1.6rem;

      width: auto;
      height: auto;
    }

    &::after {
      content: "";
      position: absolute;
      top: 2.3rem;
      left: 0;
      right: 0.5rem;
      bottom: 0;

      background: url(../images/specialisms-03-bg.svg) no-repeat center / 100%
        100%;
      filter: drop-shadow(0 -10px 17px rgba(0, 0, 0, 0.25));
    }

    & .the-giants-profile-content {
      position: relative;
      margin: 0 0 0 -1rem;
      padding: 4.2rem 30% 3.6rem 5rem;

      transform: rotate(-1.191deg);

      &::before {
        content: "";
        position: absolute;
        left: 2rem;
        top: 10.31rem;
        width: 1rem;
        height: 15.625rem;
        background:
          radial-gradient(
            circle 0.5rem at 0.5rem 0.5rem,
            var(--bg-quaternary) 99%,
            transparent 100%
          ),
          radial-gradient(
            circle 0.5rem at 0.5rem calc(100% - 0.5rem),
            var(--bg-quaternary) 99%,
            transparent 100%
          );
        background:
          radial-gradient(
            circle 0.5rem at 0.5rem 0.5rem,
            var(--bg-quaternary) 99%,
            transparent 100%
          ),
          radial-gradient(
            circle 0.5rem at 0.5rem calc(100% - 0.5rem),
            var(--bg-quaternary) 99%,
            transparent 100%
          );
        background-repeat: no-repeat;
      }

      &::after {
        content: "";

        display: block;

        width: 14.5rem;
        height: 9.5625rem;

        transform: rotate(180deg);
        aspect-ratio: 185/122;

        background: url(../images/mark.png) no-repeat center bottom;
        background-size: 100% auto;

        mix-blend-mode: multiply;

        position: absolute;
        bottom: 0;
        right: 2.12rem;
        z-index: 20;
      }
    }

    & .the-giants-portrait {
      width: 12.5rem;

      top: -0.3rem;

      transform: rotate(0.08deg);
    }

    .the-giants-links {
      position: absolute;
      top: 16rem;
      right: 1.6rem;

      max-width: 13rem;

      transform: rotate(-1.191deg);
    }
  }

  .the-giants-profile--mcilroy {
    position: relative;
    margin: 6.2rem 0 0;
    padding: 0 0 5.8rem 26%;

    & .the-giants-portrait {
      position: absolute;
      top: 0;
      left: -4.7rem;

      width: 18rem;
      transform: rotate(-1.922deg);

      &::before {
        width: 5.8rem;
        height: 5.5rem;

        left: -3.4rem;
      }
    }

    & .the-giants-links {
      position: absolute;
      top: 24.8rem;
      left: 0;
    }
  }

  .the-giants-profile--rosenblatt {
    position: relative;
    margin: 0 4.3rem 0 -6.3rem;

    transform: rotate(-1.189deg);

    padding: 5.4rem 30% 3.8rem 4.5rem;

    & .the-giants-portrait {
      position: absolute;
      top: 3.6rem;
      right: 1.7rem;

      width: 14.3rem;
      aspect-ratio: 10/13;
      transform: rotate(1.189deg);

      &::after {
        right: 0.4rem;
      }
    }

    & .the-giants-links {
      position: absolute;
      top: 25.8rem;
      left: 76%;
    }
  }

  .the-giants-profile--sutherland {
    position: relative;
    margin: 4.9rem 5.8rem 0 0;

    padding: 0 0 2.8rem 30%;

    & .the-giants-portrait {
      position: absolute;
      top: 0;
      left: 0;
    }

    & .the-giants-links {
      position: absolute;
      top: 20.3rem;
      left: 0;
    }
  }

  .the-giants-profile--alexander {
    margin: 3.2rem -6rem 0 0;

    padding: 4.6rem 6.5rem 6.1rem 30%;

    & .the-giants-portrait {
      position: absolute;
      top: 2.6rem;
      left: 0.8rem;
      margin: 0;

      max-width: 17.1rem;

      & img {
        position: relative;
        right: -0.5rem;
      }

      &::before {
        width: 2.5rem;
        height: 25.5rem;
      }
    }

    & .the-giants-links {
      position: absolute;
      top: 26.8rem;
      left: 5rem;
    }

    & .the-giants-bio {
      column-count: 2;
      column-gap: 2rem;
    }

    & .the-giants-name {
      font-size: 2rem;
      text-transform: uppercase;
    }
  }

  .the-giants-profile--kripke {
    position: relative;
    margin: 2.6rem 0 0 0;

    padding: 0 36% 0 0;

    & .the-giants-portrait {
      position: absolute;
      top: 2.5rem;
      right: 5.2rem;
    }

    & .the-giants-links {
      position: absolute;
      top: 20.8rem;
      left: 74%;
    }
  }

  .the-giants-profile--altshuller {
    position: relative;
    margin: 1.4rem 4.3rem 0 -6.9rem;

    padding: 5.4rem 30% 4.1rem 4.5rem;

    transform: rotate(-1.189deg);

    & .the-giants-portrait {
      position: absolute;
      top: 3.7rem;
      right: 3rem;

      transform: rotate(1.189deg);
    }

    & .the-giants-links {
      position: absolute;
      top: 25.8rem;
      left: 76%;
    }
  }

  .the-giants-profile--gang-of-four {
    position: relative;
    margin: 2.6rem 0 0 5rem;

    padding: 4.2rem 2.5rem 0 22%;

    & .the-giants-portrait {
      position: absolute;
      left: 0;
      top: 4.2rem;
    }

    & .the-giants-links {
      position: absolute;
      top: 15.8rem;
      left: 0;
    }

    & .the-giants-name {
      position: absolute;
      top: 0rem;
      left: 0;
    }
  }

  .the-giants-profile--huizinga {
    position: relative;
    margin: 3.5rem 0 0 1.9rem;

    padding: 6rem 30% 9.6rem 7rem;

    &::before {
      content: "";
      position: absolute;
      right: -2.8rem;
      top: 3.7rem;
      width: 16.1rem;
      height: 29.5rem;
      transform: rotate(1.455deg);

      background-color: var(--bg-eleventh);
    }

    & .the-giants-profile-content {
      left: 2.3rem;
      right: 1.8rem;

      width: auto;
    }

    & .the-giants-portrait {
      right: -1.25rem;
    }

    .the-giants-links {
      position: absolute;
      top: 20rem;
      left: 83.5%;
    }
  }

  .the-giants-profile--vygotsky {
    position: relative;
    margin: 2rem 0 0 -3.1rem;

    padding: 0 0 0 28%;

    & .the-giants-portrait {
      position: absolute;
      top: 0;
      left: 0;
    }

    & .the-giants-links {
      position: absolute;
      top: 25rem;
      left: 3.1rem;
    }
  }
}
