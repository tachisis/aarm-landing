.hiring-us-misha {
  position: absolute;
  top: -1.4rem;
  right: 1.8rem;
  width: 12.83969rem;
  height: 14.86863rem;
  transform: rotate(6.63deg);

  border-radius: 0.84988rem;
  background: var(--bg-quinary);
  box-shadow: 0 4px 24px 0 rgba(0, 0, 0, 0.1);

  &::before {
    position: absolute;
    top: -0.41rem;
    right: 1.4rem;

    width: 1.2rem;
    height: 3.3rem;

    transform: rotate(5.388deg);

    content: "";

    display: block;

    background: url("../images/clip-3.svg") no-repeat;
    background-size: contain;
  }
}

.hiring-us-misha-title {
  position: relative;
  padding: 0.89rem 0 0.2rem 0.35rem;

  font-size: 0.53675rem;
  font-weight: 500;
  line-height: normal;
  text-transform: uppercase;

  &::after {
    position: absolute;
    bottom: 0;
    right: 0.42rem;

    content: "";

    display: inline-block;
    width: 1.73806rem;
    height: 0.7605rem;

    background-image:
      linear-gradient(#302f33 0 0), linear-gradient(#302f33 0 0),
      linear-gradient(#302f33 0 0), linear-gradient(#302f33 0 0),
      linear-gradient(#302f33 0 0), linear-gradient(#302f33 0 0),
      linear-gradient(#302f33 0 0), linear-gradient(#302f33 0 0),
      linear-gradient(#302f33 0 0), linear-gradient(#302f33 0 0),
      linear-gradient(#302f33 0 0), linear-gradient(#302f33 0 0),
      linear-gradient(#302f33 0 0);
    background-repeat: no-repeat;
    background-position:
      0% 0,
      10.225% 0,
      15.337% 0,
      25.562% 0,
      30.674% 0,
      37.977% 0,
      48.201% 0,
      53.313% 0,
      63.537% 0,
      68.65% 0,
      76.317% 0,
      86.541% 0,
      94.208% 0;
    background-size:
      5.111% 100%,
      2.556% 100%,
      7.668% 100%,
      2.556% 100%,
      5.111% 100%,
      5.111% 100%,
      2.556% 100%,
      7.668% 100%,
      2.556% 100%,
      5.111% 100%,
      7.668% 100%,
      2.556% 100%,
      5.111% 100%;
  }
}

.hiring-us-misha-portrait {
  background: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 0.27rem,
    rgba(255, 255, 255, 0.5) 0.27rem,
    rgba(255, 255, 255, 0.5) calc(0.27rem + 0.41213rem),
    transparent calc(0.27rem + 0.41213rem),
    transparent calc(0.27rem + 0.41213rem + 0.27rem)
  );
}

.hiring-us-misha-caption {
  position: relative;
  padding: 0.25rem 0.5rem 0.88rem 0.35rem;

  font-size: 0.38044rem;
  font-style: normal;
  font-weight: 500;
  line-height: normal;
  text-transform: uppercase;

  &::after {
    content: "";
    position: absolute;
    top: 0.3rem;
    right: 0.45rem;
    width: 0.3rem;
    height: 0.86038rem;
    background: url("../images/arrow.svg") no-repeat;
    background-size: contain;
  }
}

.hiring-us-title {
  margin: 0 0 5.3rem;
}

.hiring-us-about {
  display: flex;
  gap: 0.4rem;

  dt {
    flex: 0 0 4rem;

    font-family: "Aaic", sans-serif;
    font-size: var(--text-xl);
    line-height: 1;
    letter-spacing: -0.04em;

    color: var(--text-accent);

    text-align: right;
  }

  dd {
    position: relative;
    margin-top: 0.5rem;

    font-size: var(--text-base);
    line-height: normal;

    a:not([class]) {
      color: var(--text-accent);
    }

    ins {
      font-family: "Aaic", sans-serif;
      font-size: var(--text-base);
      line-height: normal;
      letter-spacing: -0.06em;

      color: var(--text-accent);

      text-decoration: none;
    }
  }
}

.hiring-us-about--01 {
  margin-bottom: 0.8rem;

  dd ins {
    position: absolute;
    top: -0.8rem;
    left: 5.75rem;

    width: 10.6rem;
    transform: rotate(-3.683deg) translateY(-100%);
  }
}

.hiring-us-about--02 {
  margin-bottom: 1.4rem;

  dt {
    transform: rotate(-11.747deg) translateY(-0.3rem);
  }

  dd ins {
    position: absolute;
    bottom: -1.8rem;
    right: 2.2rem;

    width: 9rem;
    transform: rotate(-4.183deg);

    font-size: var(--text-xl);

    &::after {
      content: "";
      position: absolute;
      top: -1.2rem;
      right: 0.3rem;
      width: 1rem;
      height: 1.2rem;
      background: url("../images/arrow-1.svg") no-repeat;
      background-size: contain;
    }
  }
}

.hiring-us-note {
  position: relative;
  margin-left: 1rem;
  padding-right: 45%;

  font-size: var(--text-base);
  line-height: normal;

  a:not([class]) {
    color: var(--text-accent);
  }

  ins {
    position: absolute;
    bottom: -0.4rem;
    left: 7.8rem;
    width: 10.6rem;
    transform: translateY(100%);

    font-size: var(--text-xl);
    font-family: "Aaic", sans-serif;
    line-height: normal;
    letter-spacing: -0.06em;

    color: var(--text-accent);

    text-decoration: none;

    &::after {
      content: "";
      position: absolute;
      top: -0.1rem;
      left: -0.9rem;
      width: 0.8rem;
      height: 1rem;
      background: url("../images/arrow-2.svg") no-repeat;
      background-size: contain;
    }
  }
}

@media (--desktop) {
  .hiring-us {
    margin: -9.3rem -2rem calc(9 / 80 * 100%) -12%;
    padding: 1.3rem 60% 2rem 3.8rem;

    &::after {
      aspect-ratio: 80 / 9;
    }
  }

  .hiring-us-misha {
    top: -0.9rem;
    right: 6.9rem;
    width: 24.25rem;
    height: 28.08213rem;
    transform: none;
    border-radius: 1.60513rem;
    z-index: 10;

    &::before {
      top: -0.8rem;
      right: 3.4rem;

      width: 1.7rem;
      height: 6.5rem;
      transform: rotate(5.388deg);
    }
  }

  .hiring-us-misha-title {
    font-size: 1.01375rem;
    padding: 1.8rem 0 0.2rem 0.35rem;

    &::after {
      width: 3.6rem;
      height: 1.5rem;
      right: 0.7rem;
    }
  }

  .hiring-us-title {
    margin: 0 0 8.5rem -9%;
    transform: rotate(-3.276deg);
  }

  .hiring-us-misha-caption {
    padding: 0.5rem 0.7rem 1.2rem;
    font-size: 0.7185rem;

    &::after {
      top: auto;
      bottom: 0;
      width: 0.8rem;
      height: 1.9rem;
    }
  }

  .hiring-us-about {
    dt {
      font-size: var(--text-lg);
    }

    dd {
      font-size: var(--text-sm);
      font-weight: 500;
      line-height: 1.2;
    }
  }

  .hiring-us-about--01 {
    margin-bottom: 0.6rem;

    & dt {
      position: relative;
      top: -1.5rem;
    }

    & dd {
      & ins {
        top: -3rem;
        left: 9rem;
        width: 12rem;
        transform: none;
        font-size: 1.2rem;
        font-weight: 500;
      }
    }
  }

  .hiring-us-about--02 {
    margin-bottom: 3rem;

    & dd {
      & ins {
        bottom: -2rem;
        right: 0;
        width: auto;
        font-size: var(--text-lg);

        &::after {
          right: auto;
          left: -1.2rem;
          transform: scaleX(-1);
          top: -0.9rem;
          bottom: auto;
        }
      }
    }
  }

  .hiring-us-note {
    margin-left: 7.2rem;
    padding-right: 0;
    font-size: var(--text-sm);
    font-weight: 500;

    & ins {
      top: -3rem;
      bottom: auto;
      right: auto;
      left: -4.5rem;
      font-size: var(--text-lg);

      &::after {
        display: none;
      }
    }
  }
}
