.folder {
  position: relative;
  padding: 0.94rem 0;

  background-color: var(--bg-secondary);
  border-radius: 1.1rem;

  color: var(--text-invert);
}

.folder--tertiary {
  background-color: var(--bg-tertiary);
}

.folder--tertiary .folder-tab {
  background: var(--bg-tertiary);
}

.folder--quaternary {
  background-color: var(--bg-quaternary);
}

.folder--quaternary .folder-tab {
  background: var(--bg-quaternary);
}

.folder--quinary {
  background-color: var(--bg-quinary);
}

.folder--quinary .folder-tab {
  background: var(--bg-quinary);
}

.folder--senary {
  background-color: var(--bg-senary);
}

.folder--senary .folder-tab {
  background: var(--bg-senary);
}

.folder--septenary {
  background-color: var(--bg-septenary);
}

.folder--septenary .folder-tab {
  background: var(--bg-septenary);
}

.folder-tab {
  position: absolute;
  top: -2.4rem;
  left: 0.9rem;

  display: block;
  width: 9.5rem;
  padding: 0.5rem 0 0.95rem 2rem;

  color: var(--text-invert);
  font-size: var(--text-lg);
  font-weight: 300;
  text-transform: uppercase;

  background: var(--bg-secondary);
  clip-path: path(
    "M16.5 13C16.5 5.8203 22.3203 0 29.5 0H86.6729C91.2213 0 95.4389 2.37716 97.7942 6.26824L113.706 32.5553C116.061 36.4463 120.279 38.8235 124.827 38.8235H148C150.209 38.8235 152 40.6144 152 42.8235V51.5H0V38.8235H3.5C10.6797 38.8235 16.5 33.0032 16.5 25.8235V13Z"
  );
}

.folder-tab--right {
  left: auto;
  right: 0.8rem;
  padding: 0.6rem 2rem 0.95rem 0;
  text-align: right;
  clip-path: path(
    "M135.5 13C135.5 5.8203 129.6797 0 122.5 0H65.3271C60.7787 0 56.5611 2.37716 54.2058 6.26824L38.294 32.5553C35.939 36.4463 31.721 38.8235 27.173 38.8235H4C1.791 38.8235 0 40.6144 0 42.8235V51.5H152V38.8235H148.5C141.3203 38.8235 135.5 33.0032 135.5 25.8235V13Z"
  );
}

@media (--desktop) {
  .folder {
    border-radius: 1.25rem;
  }
  .folder-tab {
    left: 2.06rem;

    font-size: var(--text-base);
  }

  .folder-tab--right {
    left: auto;
    right: 2.06rem;
  }
}
