@custom-media --desktop (min-width: 64rem); /* 1024px */

:root {
  --text-xxs: clamp(0.625rem, 0.55rem + 0.35vw, 0.75rem);
  --text-xs: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
  --text-sm: clamp(0.875rem, 0.8rem + 0.35vw, 1rem);
  --text-base: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
  --text-lg: clamp(1.125rem, 1rem + 0.75vw, 1.5rem);
  --text-xl: clamp(1.5rem, 1.2rem + 1.25vw, 2rem);
  --text-2xl: clamp(1.75rem, 1.5rem + 1.25vw, 2.5rem);
  --text-3xl: clamp(2rem, 1.5rem + 2.5vw, 3rem);

  --bg-main: #302f33;
  --bg-content: #fff;
  --bg-secondary: #262529;
  --bg-tertiary: #515151;
  --bg-quaternary: #908070;
  --bg-quinary: #ede6d3;
  --bg-senary: #d9d9d9;
  --bg-septenary: #f5f5f5;

  --text-primary: #302f33;
  --text-invert: #fff;
  --text-accent: #1054ff;

  --base-shadow: 0 4px 4px 0 rgba(0, 0, 0, 0.25);
}
