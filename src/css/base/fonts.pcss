@font-face {
  font-family: "Aaic";
  src: url("../fonts/Aaic-Regular.woff2") format("woff2");
  font-weight: 400;
  font-style: normal;

  font-display: swap;
}

@font-face {
  font-family: "Embossing Tape 1 (BRK)";
  font-style: normal;
  font-weight: normal;
  src:
    local("Embossing Tape 1 (BRK)"),
    url("../fonts/embosst1.woff") format("woff");

  font-display: swap;
}
